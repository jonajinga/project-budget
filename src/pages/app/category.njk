---
layout: layouts/app.njk
title: "Category history"
description: "Everything one category or group has done, month by month."
permalink: /app/category/
eleventyExcludeFromCollections: true
---
{% from "partials/app-toolbar.njk" import appToolbarSubject %}
<div class="app-page app-page--dense" x-data="categoryView()" x-init="init()">
  <template x-if="!$store.budget.loading && !found()">
    <section class="hist__card hist__empty">
      <h2>That category is not in this budget</h2>
      <p>It may have been deleted, or the link belongs to another profile.</p>
      <a class="btn btn--primary" href="/app/budget/" style="margin-top: var(--space-sm);">Back to the budget</a>
    </section>
  </template>

  {# app-page__inner is what print.css looks for when it needs to find
     the page heading. This page renders its heading inside an x-if, so
     the heading is not a direct child of .app-page like everywhere
     else. #}
  <template x-if="found()">
    <div class="app-page__inner">
      {# The category name is the subject here, not a screen label: it
         says which thing you are looking at, so it stays visible. The
         breadcrumb to the parent group goes with it. #}
      {% call appToolbarSubject("Category", '<span x-text="title()"></span>') %}
        <div class="app-toolbar__group">
          <span class="app-toolbar__sep" aria-hidden="true"></span>
          <p class="hist__card-meta app-toolbar__context" style="margin: 0;">
            <template x-if="groupHref()"><a class="hist__link" :href="groupHref()" x-text="eyebrow()"></a></template>
            <template x-if="!groupHref()"><span x-text="eyebrow()"></span></template>
          </p>
          {# The note is a sentence, not a control. In the strip it was a
             451px string in a 390px row, which is what crushed this
             toolbar to nothing on a phone. It gets its own button, so it
             is one tap away at every width instead of unreadable at one. #}
          <button type="button" class="btn btn--icon" x-show="note()" x-cloak
                  @click="noteOpen = true"
                  :aria-label="'Note: ' + note()"
                  :data-tip="note()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16v12H8l-4 4z"/></svg>
          </button>
        </div>
        <div class="app-toolbar__actions">
          <span class="hist__range" role="group" aria-label="Months shown">
            <button type="button" :class="range === 6 ? 'is-active' : ''" @click="setRange(6)">6m</button>
            <button type="button" :class="range === 12 ? 'is-active' : ''" @click="setRange(12)">1y</button>
            <button type="button" :class="range === 24 ? 'is-active' : ''" @click="setRange(24)">2y</button>
            <button type="button" :class="range === 60 ? 'is-active' : ''" @click="setRange(60)">5y</button>
          </span>
          <a class="btn btn--ghost" :href="budgetHref()">Budget</a>
          <a class="btn btn--ghost" :href="registerHref()">Register</a>
        </div>
      {% endcall %}

      <div class="modal-backdrop" x-show="noteOpen" x-cloak @keydown.escape.window="noteOpen = false">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="cat-note-title" @click.outside="noteOpen = false">
          <button class="modal__close" type="button" @click="noteOpen = false" aria-label="Close">&times;</button>
          <h2 class="modal__title" id="cat-note-title">Note</h2>
          <div class="prose"><p x-text="note()"></p></div>
          <div class="form-actions">
            <button class="btn btn--primary" type="button" @click="noteOpen = false">Got it</button>
          </div>
        </div>
      </div>

      <div class="kpi-strip hist__kpis">
        <div class="kpi" :class="availableClass()">
          <span class="kpi__label">Available now</span>
          <span class="kpi__value" x-text="fmt(now().available)"></span>
          <span class="kpi__delta" x-text="now().available < 0 ? 'Overspent, needs covering' : 'Ready to spend'"></span>
        </div>
        <div class="kpi">
          <span class="kpi__label">Assigned this month</span>
          <span class="kpi__value" x-text="fmt(now().assigned)"></span>
          <span class="kpi__delta" x-text="monthLabel($store.budget.currentMonth)"></span>
        </div>
        <div class="kpi" :class="isIncome() ? 'kpi--ok' : 'kpi--danger'">
          <span class="kpi__label" x-text="flowWord() + ' this month'"></span>
          <span class="kpi__value" x-text="fmt(now()[flowKey()])"></span>
          <span class="kpi__delta" x-text="stats().avg3 ? Math.round(now()[flowKey()] / stats().avg3 * 100) + '% of the 3-month average' : ''"></span>
        </div>
        <div class="kpi">
          <span class="kpi__label">Average per month</span>
          <span class="kpi__value" x-text="fmt(stats().avgAll)"></span>
          <span class="kpi__delta" x-text="'Over ' + stats().months + ' months'"></span>
        </div>
        <div class="kpi kpi--muted">
          <span class="kpi__label">Trend</span>
          <span class="kpi__value" style="font-size: var(--fs-lg);" x-text="stats().trendPct == null ? '-' : (stats().trendPct > 0 ? '+' : '') + stats().trendPct + '%'"></span>
          <span class="kpi__delta" :class="trend().cls" x-text="trend().text"></span>
        </div>
      </div>

      <div class="hist__grid" style="margin-top: var(--space-md);">
        <section class="hist__card hist__card--wide">
          <div class="hist__card-head">
            <h2 class="hist__card-title" x-text="flowWord() + ' each month'"></h2>
            <span class="hist__card-meta" x-text="'Total ' + fmt(stats().total) + ', assigned ' + fmt(stats().assignedTotal)"></span>
          </div>
          <div x-effect="window.PBMini && window.PBMini.into($el, flowSpec())"></div>
          <div class="hist__legend"><span x-text="flowWord() + (isIncome() ? '' : ' (red when the month ended overspent)')"></span><span class="is-line">Assigned</span></div>
        </section>

        <section class="hist__card">
          <div class="hist__card-head">
            <h2 class="hist__card-title">Available at month end</h2>
          </div>
          <div x-effect="window.PBMini && window.PBMini.into($el, availableSpec())"></div>
        </section>

        <section class="hist__card">
          <div class="hist__card-head"><h2 class="hist__card-title">By the numbers</h2></div>
          <dl style="margin: 0;">
            <div class="hist__stat"><dt>Last 3 months, average</dt><dd x-text="fmt(stats().avg3)"></dd></div>
            <div class="hist__stat"><dt>Last 6 months, average</dt><dd x-text="fmt(stats().avg6)"></dd></div>
            <div class="hist__stat"><dt>Last 12 months, average</dt><dd x-text="fmt(stats().avg12)"></dd></div>
            <div class="hist__stat"><dt>Biggest month</dt><dd x-text="stats().maxMonth ? fmt(stats().maxOutflow) + ' in ' + monthLabel(stats().maxMonth, true) : '-'"></dd></div>
            <div class="hist__stat"><dt>Months with activity</dt><dd x-text="stats().activeMonths + ' of ' + stats().months"></dd></div>
            <div class="hist__stat" x-show="!isIncome()"><dt>Months ended overspent</dt><dd x-text="stats().overspentMonths"></dd></div>
            <div class="hist__stat" x-show="!isIncome()"><dt>Assigned minus spent</dt><dd x-text="(stats().assignedVsSpent >= 0 ? '+' : '') + fmt(stats().assignedVsSpent)"></dd></div>
          </dl>
        </section>

        <template x-if="goal()">
          <section class="hist__card">
            <div class="hist__card-head">
              <h2 class="hist__card-title">Goal</h2>
              <span class="hist__pill" :class="goalPillClass(goalStatusNow())" x-text="goalStatusNow()"></span>
            </div>
            <dl style="margin: 0;">
              <div class="hist__stat"><dt>Type</dt><dd x-text="goalTypeLabel(goal())"></dd></div>
              <div class="hist__stat"><dt>Target</dt><dd x-text="fmt(goal().target || 0)"></dd></div>
              <div class="hist__stat" x-show="goal().byDate"><dt>By</dt><dd x-text="goal().byDate"></dd></div>
              <div class="hist__stat"><dt>Still needed this month</dt><dd x-text="fmt(goalNeededNow())"></dd></div>
              <div class="hist__stat"><dt>Months fully funded</dt><dd x-text="goalFundedCount() + ' of ' + goalHistory().length"></dd></div>
            </dl>
            <div class="cluster" style="gap: 4px; flex-wrap: wrap; margin-top: var(--space-xs);">
              <template x-for="r in goalHistory()" :key="r.month">
                <span class="hist__pill" :class="goalPillClass(r.status)" :title="monthLabel(r.month) + ': ' + r.status" x-text="monthLabel(r.month, true)"></span>
              </template>
            </div>
          </section>
        </template>

        <template x-if="cut()">
          <section class="hist__card">
            <div class="hist__card-head">
              <h2 class="hist__card-title">Planned cut</h2>
              <a class="hist__link" :href="cutsHref()">All cuts</a>
            </div>
            <p class="hist__card-meta" style="margin: 0 0 var(--space-2xs);" x-text="cutLabel() + ', since ' + monthLabel(cut().startMonth) + (cut().goalLabel ? ', toward ' + cut().goalLabel : '')"></p>
            <div x-effect="window.PBMini && cutChartSpec() && window.PBMini.into($el, cutChartSpec())"></div>
            <div class="hist__legend"><span>Saved that month</span><span class="is-line">Target</span></div>
            <dl style="margin: var(--space-xs) 0 0;">
              <div class="hist__stat"><dt>Was spending</dt><dd x-text="fmt(cutSeries().baseline) + ' a month'"></dd></div>
              <div class="hist__stat"><dt>Target saving</dt><dd x-text="fmt(cutSeries().target) + ' a month'"></dd></div>
              <div class="hist__stat"><dt>This month</dt><dd x-text="cutNow() ? fmt(cutNow().saved) + ' saved' : '-'"></dd></div>
              <div class="hist__stat"><dt>Since it started</dt><dd x-text="fmt(cutSeries().cumSaved) + ' of ' + fmt(cutSeries().cumPlanned)"></dd></div>
              <div class="hist__stat"><dt>Months met</dt><dd x-text="cutSeries().monthsMet + ' of ' + cutSeries().monthsActive + ', streak ' + cutSeries().streak"></dd></div>
            </dl>
          </section>
        </template>

        <template x-if="kind === 'group'">
          <section class="hist__card hist__card--wide">
            <div class="hist__card-head">
              <h2 class="hist__card-title">Categories in this group</h2>
              <span class="hist__card-meta" x-text="'Share of ' + flowWord().toLowerCase() + ' over ' + range + ' months'"></span>
            </div>
            <div class="hist__table-wrap">
              <table class="hist__table table table--stack">
                <thead><tr><th>Category</th><th class="col-p2" style="text-align:left;">Share</th><th>Average</th><th>This month</th><th>Assigned</th><th>Available</th></tr></thead>
                <tbody>
                  <template x-for="r in breakdown()" :key="r.id">
                    <tr>
                      <td><a class="hist__link" :href="memberHref(r.id)" x-text="r.name"></a> <span class="hist__card-meta" x-show="r.hidden">hidden</span></td>
                      <td class="col-p2" style="text-align:left;"><span class="hist__breakdown-bar" :style="'width:' + Math.round(r.share / maxShare() * 120) + 'px'"></span><span x-text="r.share + '%'"></span></td>
                      <td data-label="Average" x-text="fmt(r.avg)"></td>
                      <td data-label="This month" x-text="fmt(r.now)"></td>
                      <td data-label="Assigned" x-text="fmt(r.assigned)"></td>
                      <td data-label="Available" :style="r.available < 0 ? 'color: var(--danger);' : ''" x-text="fmt(r.available)"></td>
                    </tr>
                  </template>
                </tbody>
              </table>
            </div>
          </section>
        </template>

        <section class="hist__card">
          <div class="hist__card-head"><h2 class="hist__card-title">Where it goes</h2><span class="hist__card-meta">Top payees in this window</span></div>
          <template x-if="!topPayees().length"><p class="mini-chart__empty">No transactions in this window.</p></template>
          <div class="hist__table-wrap" x-show="topPayees().length">
            <table class="hist__table table table--stack">
              <thead><tr><th>Payee</th><th class="col-p2">Share</th><th>Percent</th><th>Total</th></tr></thead>
              <tbody>
                <template x-for="p in topPayees()" :key="p.name">
                  <tr>
                    <td x-text="p.name"></td>
                    <td class="col-p2" style="text-align:left; width: 40%;"><span class="hist__breakdown-bar" :style="'width:' + Math.round(p.share) + '%'"></span></td>
                    <td data-label="Percent" x-text="p.share + '%'"></td>
                    <td data-label="Total" x-text="fmt(p.total)"></td>
                  </tr>
                </template>
              </tbody>
            </table>
          </div>
        </section>

        <section class="hist__card">
          <div class="hist__card-head"><h2 class="hist__card-title">Month by month</h2></div>
          <div class="hist__table-wrap" style="max-height: 360px; overflow-y: auto;">
            <table class="hist__table table table--stack">
              <thead><tr><th>Month</th><th>Assigned</th><th x-text="flowWord()"></th><th>Available</th></tr></thead>
              <tbody>
                <template x-for="r in series().slice().reverse()" :key="r.month">
                  <tr :class="r.month === $store.budget.currentMonth ? 'is-current' : ''">
                    <td x-text="monthLabel(r.month)"></td>
                    <td data-label="Assigned" x-text="fmt(r.assigned)"></td>
                    <td :data-label="flowWord()" x-text="fmt(r[flowKey()])"></td>
                    <td data-label="Available" :style="r.available < 0 ? 'color: var(--danger);' : ''" x-text="fmt(r.available)"></td>
                  </tr>
                </template>
              </tbody>
            </table>
          </div>
        </section>

        <section class="hist__card hist__card--wide">
          <div class="hist__card-head">
            <h2 class="hist__card-title">Recent transactions</h2>
            <span class="hist__card-meta" x-text="transactions().length + ' total'"></span>
          </div>
          <template x-if="!transactions().length"><p class="mini-chart__empty">Nothing recorded here yet.</p></template>
          <div class="hist__table-wrap" x-show="transactions().length">
            <table class="hist__table">
              <thead><tr><th style="text-align:left;">Payee</th><th class="col-p2">Date</th><th class="col-p2" style="text-align:left;">Account</th><th class="col-p3" style="text-align:left;" x-show="kind === 'group'">Category</th><th class="col-p3" style="text-align:left;">Memo</th><th>Amount</th></tr></thead>
              <tbody>
                <template x-for="t in recentTransactions()" :key="t.id">
                  <tr>
                    <td style="text-align:left;">
                      <span x-text="t.payee || '-'"></span>
                      <span class="hist__card-meta" x-text="t.date"></span>
                    </td>
                    <td class="col-p2" data-label="Date" x-text="t.date"></td>
                    <td class="col-p2" data-label="Account" style="text-align:left;" x-text="accountName(t.accountId)"></td>
                    <td class="col-p3" data-label="Category" style="text-align:left;" x-show="kind === 'group'" x-text="catName(t.categoryId)"></td>
                    <td class="col-p3" data-label="Memo" style="text-align:left; white-space: normal;" x-text="t.memo"></td>
                    <td data-label="Amount" :style="t.amount < 0 ? '' : 'color: var(--ok);'" x-text="fmt(t.amount)"></td>
                  </tr>
                </template>
              </tbody>
            </table>
          </div>
          <div class="form-actions" x-show="transactions().length > txnLimit" style="margin-top: var(--space-xs);">
            <button class="btn btn--ghost btn--sm" type="button" @click="txnLimit += 25">Show more</button>
          </div>
        </section>
      </div>
    </div>
  </template>
</div>
