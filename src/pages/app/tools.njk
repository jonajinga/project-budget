</div>

<style>
  /* U5. Sixteen tiles. A hard-coded three columns left the sixteenth
     alone on its own row at every desktop width.

     auto-fill lets the column count follow the space instead of being
     stated once. The floor of one quarter of the row caps it at four,
     which is what stops a very wide window picking five - the other
     count that cannot come out even, since 16 divides by 1, 2 and 4
     and not by 3 or 5. */
  .tools-grid {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fill, minmax(max(15rem, calc((100% - 3 * var(--space-md)) / 4)), 1fr));
  }
  /* Between roughly 900 and 1380 the row has space for three tracks
     and not four. Two columns there rather than a stranded sixteenth
     tile. */
  @media (min-width: 600px) and (max-width: 1379px) {
    .tools-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 599px)  { .tools-grid { grid-template-columns: 1fr; } }
  .tools-card { display: block; padding: var(--space-md); background: var(--bg-elevated); border: 1px solid var(--border-soft); border-left: 3px solid var(--accent); border-radius: var(--radius-input); color: var(--fg); text-decoration: none; transition: background var(--t-fast), border-color var(--t-fast), transform var(--t-fast); }
  .tools-card:hover { background: var(--bg-alt); border-color: var(--accent); transform: translateY(-1px); }
  .tools-card__title { margin: 0 0 var(--space-2xs); font-family: var(--font-display); font-size: var(--fs-lg); color: var(--fg); }
  .tools-card:hover .tools-card__title { color: var(--accent); }
  .tools-card p { margin: 0; color: var(--fg-muted); font-size: var(--fs-sm); line-height: 1.5; }
</style>
