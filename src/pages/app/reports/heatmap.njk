---
layout: layouts/app.njk
title: "Category heatmap"
description: "Spending intensity by category and month at a glance - spot seasonal patterns and unexpected spikes."
permalink: /app/reports/heatmap/
eleventyExcludeFromCollections: true
---
{% from "partials/report-chrome.njk" import reportChrome %}
<div class="app-page app-page--dense" x-data="heatmapView()" x-init="init()">
  {% call reportChrome(
       title="Category heatmap",
       id="heatmap",
       infoTitle="About the category heatmap",
       infoLabel="How to read the heatmap",
       info="<p>Each row is a category, each column a month. Cells get darker the more you spent - spot seasonal patterns (heating bills, holiday gifts) and one-off spikes (an unexpected vet visit) without digging through the register.</p>",
       save="Save this range + top N as a recall-able view in /app/templates/.",
       slug="",
       csv="exportRowsCSV()",
       count='<span x-text="data.categories.length"></span> categories, <span x-text="data.months.length"></span> months') %}
    <span class="chart-picker" role="group" aria-label="Range">
      <template x-for="r in ranges" :key="r.value">
        <button type="button" class="chart-picker__btn"
                :class="rangeMonths === r.value ? 'is-active' : ''"
                :aria-pressed="(rangeMonths === r.value).toString()"
                @click="rangeMonths = r.value"
                x-text="r.label"></button>
      </template>
    </span>
    <div class="field">
      <label class="visually-hidden" for="hm-topn">How many categories</label>
      <select class="select" id="hm-topn" x-model.number="topN"
              data-tip="How many categories to show, by total spend.">
        <template x-for="opt in topNOptions" :key="opt">
          <option :value="opt" x-text="'Top ' + opt"></option>
        </template>
      </select>
    </div>
  {% endcall %}

  <div class="kpi-strip">
    <div class="kpi kpi--accent">
      <span class="kpi__label">Categories shown</span>
      <span class="kpi__value" x-text="data.categories.length"></span>
      <span class="kpi__delta" x-text="'Top ' + topN + ' by spend'"></span>
    </div>
    <div class="kpi kpi--danger">
      <span class="kpi__label">Window total</span>
      <span class="kpi__value" x-text="fmt(kpis().total)"></span>
      <span class="kpi__delta" x-text="rangeMonths + '-month window'"></span>
    </div>
    <div class="kpi kpi--muted">
      <span class="kpi__label">Hottest cell</span>
      <span class="kpi__value" x-text="fmt(kpis().peakValue)"></span>
      <span class="kpi__delta" x-text="kpis().peakLabel || ''"></span>
    </div>
    <div class="kpi kpi--muted">
      <span class="kpi__label">Avg per category</span>
      <span class="kpi__value" x-text="fmt(kpis().avgPerCat)"></span>
      <span class="kpi__delta">Across the window</span>
    </div>
  </div>

  <section class="report">
    {# No aria-describedby here: this is the one chart report with no data
       table to point at, and the old reference resolved to nothing. Give it
       a real table alongside the other reports rather than a dangling id. #}
    <div class="chart" id="chart-heatmap" style="min-height: 360px; overflow-x: auto;"
         role="img" aria-label="Category heatmap"></div>
  </section>
</div>

<script>
function heatmapView() {
  return {
    rangeMonths: 12,
    topN: 15,
    ranges: [
      { value: 3,  label: "3 mo" },
      { value: 6,  label: "6 mo" },
      { value: 12, label: "12 mo" },
      { value: 24, label: "24 mo" },
    ],
    topNOptions: [10, 15, 20, 30],

    get data() {
      void this.$store.budget._listVersion;
      return this.$store.budget.reportHeatmap(null, this.rangeMonths, this.topN) || { months: [], categories: [], cells: {}, max: 0 };
    },

    flatRows() {
      var out = [];
      var d = this.data;
      d.categories.forEach(function (cat) {
        d.months.forEach(function (m) {
          var v = (d.cells[cat.categoryId] || {})[m] || 0;
          out.push({
            category: cat.category,
            group: cat.group || "",
            month: m,
            value: v,
          });
        });
      });
      return out;
    },

    kpis() {
      var d = this.data;
      var total = 0, peakValue = 0, peakLabel = "";
      d.categories.forEach(function (cat) {
        d.months.forEach(function (m) {
          var v = (d.cells[cat.categoryId] || {})[m] || 0;
          total += v;
          if (v > peakValue) {
            peakValue = v;
            peakLabel = cat.category + " · " + m;
          }
        });
      });
      return {
        total: total,
        peakValue: peakValue,
        peakLabel: peakLabel,
        avgPerCat: d.categories.length ? Math.round(total / d.categories.length) : 0,
      };
    },

    fmt(c) {
      return ((c || 0) / 100).toLocaleString("en-US", { style: "currency", currency: "USD" });
    },

    /* URL state sync — write rangeMonths + topN back to the address
       bar so the view is shareable + save-able. */
    _syncUrl() {
      try {
        var parts = [];
        if (this.rangeMonths !== 12) parts.push("range=" + this.rangeMonths);
        if (this.topN        !== 15) parts.push("top="   + this.topN);
        var qs = parts.length ? ("?" + parts.join("&")) : "";
        history.replaceState(null, "", window.location.pathname + qs);
      } catch (_e) {}
    },
    saveCurrentView() {
      this._syncUrl();
      this.$dispatch("pb:save-view", { kind: "heatmap", name: "" });
    },

    init() {
      var self = this;
      /* Honor incoming URL params from a recalled saved view. */
      try {
        var p = new URL(window.location.href).searchParams;
        var r = Number(p.get("range"));
        if (r && [3,6,12,24].indexOf(r) !== -1) self.rangeMonths = r;
        var n = Number(p.get("top"));
        if (n && [10,15,20,30].indexOf(n) !== -1) self.topN = n;
      } catch (_e) {}
      var tries = 0;
      var poll = function () {
        var ready = window.Alpine && window.Alpine.store && window.Alpine.store("budget") && window.pbMountChart && window.pbRenderHeatmap && window.d3;
        if (!ready) { if (++tries < 600) setTimeout(poll, 50); return; }
        var store = Alpine.store("budget");
        self.chart = window.pbMountChart("#chart-heatmap", window.pbRenderHeatmap, function () {
          return store.reportHeatmap(null, self.rangeMonths, self.topN);
        });
        self.$watch("rangeMonths", function () { self.chart && self.chart.redraw(); self._syncUrl(); });
        self.$watch("topN",        function () { self.chart && self.chart.redraw(); self._syncUrl(); });
        Alpine.effect(function () {
          store.profile; store.currentMonth; store._listVersion;
          if (self.chart) self.chart.redraw();
        });
      };
      poll();
    },

    print() { window.print(); },
    exportRowsCSV() {
      if (window.pbExportCSV) {
        window.pbExportCSV("category-heatmap", this.flatRows(), [
          { key: "group",    label: "Group" },
          { key: "category", label: "Category" },
          { key: "month",    label: "Month" },
          { key: "value",    label: "Spent", numeric: true },
        ]);
      }
    },
    exportPDF() {
      if (!window.pbExportReportPDF) return;
      var k = this.kpis();
      window.pbExportReportPDF({
        title: "Category heatmap",
        subtitle: "Top " + this.topN + " categories · trailing " + this.rangeMonths + " months",
        filename: "category-heatmap",
        kpis: [
          { label: "Categories shown", value: String(this.data.categories.length), delta: "Top " + this.topN + " by spend" },
          { label: "Window total",     value: this.fmt(k.total), delta: this.rangeMonths + "-month window" },
          { label: "Hottest cell",     value: this.fmt(k.peakValue), delta: k.peakLabel || "" },
          { label: "Avg per category", value: this.fmt(k.avgPerCat) },
        ],
        chartEl: document.getElementById("chart-heatmap"),
        columns: [
          { key: "group",    label: "Group" },
          { key: "category", label: "Category" },
          { key: "month",    label: "Month" },
          { key: "value",    label: "Spent", numeric: true },
        ],
        rows: this.flatRows(),
      });
    },
  };
}
</script>

<script type="module">
  import { mountChart } from "/assets/js/charts/bootstrap.js";
  import { render } from "/assets/js/charts/heatmap.js";
  window.pbMountChart = mountChart;
  window.pbRenderHeatmap = render;
</script>
