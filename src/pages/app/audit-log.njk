---
layout: layouts/app.njk
title: "Audit log"
description: "Append-only journal of recent mutations in this profile — useful when a household shares a profile and you want to know what changed."
permalink: /app/audit-log/
eleventyExcludeFromCollections: true
---
{% from "partials/overflow-menu.njk" import overflow %}
{% from "partials/app-toolbar.njk" import appToolbar %}
{% from "partials/page-info.njk" import pageInfo %}
<div class="app-page app-page--flush" x-data="auditLogView()" x-init="refresh()">
  {# Three selects sat in a card of their own under the masthead. They
     are filters, so they move to the collapsible row under the strip
     (see docs/app-chrome-guide.md 2b) with a count badge, because a
     filter that is on and out of sight looks like missing data. #}
  {% call appToolbar("Audit log", flush=true) %}
    <div class="app-toolbar__group">
      <button type="button"
              class="btn btn--ghost app-toolbar__filter-toggle"
              @click="filtersOpen = !filtersOpen"
              :aria-expanded="filtersOpen.toString()"
              aria-controls="audit-filters">
        Filters
        <span class="app-toolbar__filter-count" x-show="activeFilterCount()" x-cloak
              x-text="activeFilterCount()"></span>
      </button>
      <span class="app-toolbar__context"
            x-text="events().length + (events().length === 1 ? ' event' : ' events')"></span>
    </div>
    <div class="app-toolbar__actions">
      {% call overflow(label="Audit-log actions") %}
        <li role="none">
          <button type="button" role="menuitem" class="overflow-menu__item"
                  @click="open = false; refresh()">Refresh</button>
        </li>
        <li role="none">
          <button type="button" role="menuitem" class="overflow-menu__item"
                  @click="open = false; exportCSV()">Export CSV</button>
        </li>
      {% endcall %}
      {% call pageInfo(id="audit-log", title="About the audit log", label="What the log records and where it comes from") %}
        <p>Recent activity in this profile, newest-first. Built from transaction history, scheduled-template runs, and snapshot events - read-only and useful when a household shares a profile.</p>
      {% endcall %}
    </div>
  {% endcall %}

  <div class="app-filters" id="audit-filters" x-show="filtersOpen" x-cloak>
    <div class="field">
      <label class="visually-hidden" for="audit-kind">Filter by event</label>
      <select class="select" id="audit-kind" x-model="kind">
        <option value="all">All events</option>
        <option value="txn">Transactions</option>
        <option value="sched">Recurring posts</option>
        <option value="snap">Snapshots</option>
      </select>
    </div>
    <div class="field">
      <label class="visually-hidden" for="audit-account">Account</label>
      <select class="select" id="audit-account" x-model="acctId">
        <option value="">All accounts</option>
        <template x-for="a in ($store.budget.profile?.accounts || [])" :key="a.id">
          <option :value="a.id" x-text="a.name"></option>
        </template>
      </select>
    </div>
    <div class="field">
      <label class="visually-hidden" for="audit-days">Window</label>
      <select class="select" id="audit-days" x-model.number="days">
        <option :value="7">Last 7 days</option>
        <option :value="30">Last 30 days</option>
        <option :value="90">Last 90 days</option>
        <option :value="365">Last 1 year</option>
        <option :value="3650">All time</option>
      </select>
    </div>
    <button class="btn btn--ghost" type="button" x-show="activeFilterCount()" x-cloak
            @click="clearFilters()">Clear</button>
  </div>

  <p class="app-gutter" x-show="!events().length" x-cloak style="color: var(--fg-muted);">
    No events in this window.
  </p>

  {# table--stack, because this table has nowhere to scroll. It is a
     direct child of the flush page rather than a card, and .app-main
     is overflow-x: clip, so at 390 the Detail column pushed Amount to
     x=802 and it was simply unreachable - no scrollbar, no gesture.
     Below 600 each row becomes a card instead. #}
  <table class="table table--stack" x-show="events().length" x-cloak>
    <thead>
      <tr>
        <th>When</th>
        <th>Event</th>
        <th>Detail</th>
        <th class="num">Amount</th>
      </tr>
    </thead>
    <tbody>
      <template x-for="(e, i) in events()" :key="i">
        <tr>
          <td style="white-space: nowrap;" x-text="e.date"></td>
          <td data-label="Event">
            <span class="audit-badge" :class="'audit-badge--' + e.kind" x-text="e.label"></span>
          </td>
          <td data-label="Detail" x-text="e.detail"></td>
          <td class="num" data-label="Amount" :class="e.amount < 0 ? 'amount--outflow' : (e.amount > 0 ? 'amount--inflow' : '')"
              x-text="e.amount != null ? formatCents(e.amount) : ''"></td>
        </tr>
      </template>
    </tbody>
  </table>

  {# Prose keeps its 70ch measure but not a card, and no top margin:
     a gap on a flush page shows the ground through it. #}
  <section class="prose app-gutter">
    <h2>What's in the log</h2>
    <ul>
      <li><strong>Transactions</strong> — built from <code>profile.transactions</code>. Date and amount are accurate; "who created it" isn't tracked yet.</li>
      <li><strong>Recurring posts</strong> — built from <code>scheduled.lastRun</code> for templates that have ever posted.</li>
      <li><strong>Snapshots</strong> — every manual or auto-captured snapshot of net worth + Ready to Work.</li>
    </ul>
    <p>Future: when multi-user / shared profiles ship, this log will also include "who" (which device, which member). For now everything is attributed to the active browser.</p>
  </section>
</div>

<script>
function auditLogView() {
  return {
    kind: "all",
    acctId: "",
    days: 30,

    /* The three selects live in the collapsible filter row under the
       strip. filtersOpen drives it; activeFilterCount() drives the
       badge, so a filter that is on is never invisible. The window
       select counts only when it is off its 30-day default. */
    filtersOpen: false,

    activeFilterCount() {
      var n = 0;
      if (this.kind !== "all") n += 1;
      if (this.acctId !== "") n += 1;
      if (this.days !== 30) n += 1;
      return n;
    },

    clearFilters() {
      this.kind = "all";
      this.acctId = "";
      this.days = 30;
    },

    refresh() { /* getter is reactive - placeholder for an explicit refresh button. */ },

    formatCents(c) {
      return ((c || 0) / 100).toLocaleString("en-US", { style: "currency", currency: "USD" });
    },

    events() {
      void this.$store.budget._listVersion;
      var p = this.$store.budget.profile;
      if (!p) return [];
      var cutoffMs = Date.now() - (this.days * 24 * 60 * 60 * 1000);
      var cutoffISO = new Date(cutoffMs).toISOString().slice(0, 10);
      var rows = [];
      var s = this.$store.budget;

      /* Transactions */
      if (this.kind === "all" || this.kind === "txn") {
        p.transactions.forEach(function (t) {
          if (t.date < cutoffISO) return;
          if (this.acctId && t.accountId !== this.acctId) return;
          rows.push({
            date: t.date,
            kind: "txn",
            label: "Transaction",
            detail: (s.payeeName(t.payeeId) || "—") + " · " + (s.findAccount(t.accountId)?.name || "—") + " · " + (s.categoryName(t.categoryId) || "Uncategorized"),
            amount: t.amount,
          });
        }, this);
      }

      /* Recurring posts (lastRun) */
      if (this.kind === "all" || this.kind === "sched") {
        (p.scheduled || []).forEach(function (sch) {
          if (!sch.lastRun || sch.lastRun.slice(0, 10) < cutoffISO) return;
          if (this.acctId && sch.template && sch.template.accountId !== this.acctId) return;
          rows.push({
            date: sch.lastRun.slice(0, 10),
            kind: "sched",
            label: "Recurring posted",
            detail: ((sch.template && sch.template.payeeName) || "Untitled template") + " · " + s.frequencyLabel(sch),
            amount: (sch.template && sch.template.amount) || 0,
          });
        }, this);
      }

      /* Snapshots */
      if (this.kind === "all" || this.kind === "snap") {
        (p.snapshots || []).forEach(function (sn) {
          if (sn.date.slice(0, 10) < cutoffISO) return;
          rows.push({
            date: sn.date.slice(0, 10),
            kind: "snap",
            label: "Snapshot",
            detail: "Net worth captured: " + ((sn.netWorth || 0) / 100).toFixed(0),
            amount: null,
          });
        });
      }

      rows.sort(function (a, b) { return b.date.localeCompare(a.date); });
      return rows;
    },

    exportCSV() {
      var rows = this.events();
      if (!rows.length) return;
      var header = ["Date", "Event", "Detail", "Amount"].join(",");
      var body = rows.map(function (r) {
        return [r.date, r.label, JSON.stringify(r.detail), r.amount != null ? (r.amount / 100).toFixed(2) : ""].join(",");
      }).join("\r\n");
      var blob = new Blob([header + "\r\n" + body], { type: "text/csv;charset=utf-8" });
      var url = URL.createObjectURL(blob);
      var a = document.createElement("a");
      a.href = url; a.download = "audit-log-" + new Date().toISOString().slice(0, 10) + ".csv";
      document.body.appendChild(a); a.click(); document.body.removeChild(a);
      setTimeout(function () { URL.revokeObjectURL(url); }, 1500);
    },
  };
}
</script>

<style>
  .audit-badge { display: inline-block; padding: 2px 8px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; border-radius: var(--radius-input); background: var(--bg-alt); color: var(--fg-muted); }
  .audit-badge--txn   { background: color-mix(in oklab, var(--accent) 12%, var(--bg)); color: var(--accent); }
  .audit-badge--sched { background: color-mix(in oklab, var(--warn) 14%, var(--bg)); color: var(--warn); }
  .audit-badge--snap  { background: color-mix(in oklab, var(--ok) 12%, var(--bg)); color: var(--ok); }
</style>
