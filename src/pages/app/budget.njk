---
layout: layouts/app.njk
title: "Budget"
description: "Assign every dollar a job. Monthly envelope budget view."
permalink: /app/budget/
eleventyExcludeFromCollections: true
---
{% from "partials/icon-trash.njk" import iconTrash %}
{% from "partials/overflow-menu.njk" import overflow %}
{% from "partials/empty-state.njk" import emptyState %}
<div class="app-page app-page--budget" x-data="budgetView()" x-init="init()">

  {# Visually-hidden page heading — SR users land on a clear page
     title; sighted users see the month strip + RTA card as the
     visual title. Replaces the missing h1 the WCAG audit flagged. #}
  <h1 class="visually-hidden">
    Budget — <span x-text="monthHeaderLabel()">this month</span>
  </h1>

  {# Budget HUD — the month picker + RTA + toolbar render as a single
     visually unified surface (one outer border, internal hairline
     dividers) so the eye reads them as one HUD instead of three
     floating bars. #}
  <div class="budget__hud" x-show="hasCategories" x-cloak>
    {# Not a tablist. There is no tabpanel anywhere in the app, the two
       year-nav buttons sat inside it as non-tab children, and the real tabs
       were behind a role="presentation" wrapper -- so it failed
       aria-required-children and promised keyboard behaviour it never had.
       A labelled group of buttons with aria-current is what this actually
       is. #}
    <div class="month-strip" role="group" aria-label="Budget month">
      <button type="button" class="month-strip__year"
              @click="$store.budget.setMonth(prevYearMonth())"
              aria-label="Previous year">
        <span aria-hidden="true">&larr;</span>
        <span x-text="prevYearLabel()"></span>
      </button>
      <button type="button" class="month-strip__year month-strip__step"
              @click="$store.budget.setMonth(prevMonthValue())"
              aria-label="Previous month" data-tip="Previous month">
        <span aria-hidden="true">&lsaquo;</span>
      </button>
      <div class="month-strip__tabs">
        <template x-for="m in monthsOfYear()" :key="m.value">
          <button type="button"
                  class="month-strip__tab"
                  :class="{ 'is-active': m.value === $store.budget.currentMonth, 'is-current': m.value === thisMonthValue() }"
                  :aria-current="m.value === $store.budget.currentMonth ? 'true' : 'false'"
                  :aria-label="m.label + (m.value === $store.budget.currentMonth ? ', selected month' : '')"
                  @click="$store.budget.setMonth(m.value)"
                  x-text="m.label"></button>
        </template>
      </div>
      <button type="button" class="month-strip__year month-strip__step"
              @click="$store.budget.setMonth(nextMonthValue())"
              aria-label="Next month" data-tip="Next month">
        <span aria-hidden="true">&rsaquo;</span>
      </button>
      <button type="button" class="month-strip__year"
              @click="$store.budget.setMonth(nextYearMonth())"
              aria-label="Next year">
        <span x-text="nextYearLabel()"></span>
        <span aria-hidden="true">&rarr;</span>
      </button>
    </div>

    {# The rest of the old toolbar - Ready to Work and Assigned stats,
       Auto-assign, the page kebab, the collapse and inspector toggles -
       now lives on each month card, which is the one place a person
       looks when deciding what to do with a month. Only the month-count
       picker stays up here, because it changes how many cards there are. #}
    <label class="budget__months" x-show="viewportMaxMonths > 1" x-cloak
           data-tip="How many months to show side by side. The grid scrolls sideways if it needs more room.">
      <span class="visually-hidden">Months shown</span>
      <select class="budget__months-select" :value="monthCount" @change="setMonthCount(parseInt($event.target.value, 10))" aria-label="Months shown">
        <template x-for="n in [1, 2, 3, 4, 5, 6]" :key="'mc-' + n">
          <option :value="n" :disabled="n > viewportMaxMonths" :selected="monthCount === n"
                  x-text="n + (n === 1 ? ' month' : ' months')"></option>
        </template>
      </select>
    </label>
  </div>

  {# With no categories every section on this page is x-show-gated off, so
     the budget rendered as a completely blank screen -- no explanation, no
     way forward, on the route a new user is most likely to open first. #}
  {{ emptyState(
       "!hasCategories && $store.budget.profile",
       "No categories yet",
       "The budget is where you give every dollar a job. Start with a group like Housing or Everyday, then add categories to it.",
       "Add a category group",
       "newGroupOpen = true; newGroupName = ''"
     ) }}

  <div class="budget-layout"
       :class="inspectorDocked && inspectorOpen ? 'budget-layout--open' : ''">
  <section class="budget" x-show="hasCategories" x-cloak :class="monthColClass()">
      {# Month cards - one per visible month, in the same grid as the
         rows so each spans its own value columns. Actual Budget's month
         header, in this app's vocabulary: the name, a month-scoped menu,
         the four lines that produce Ready to Work, and the number itself.
         Sits OUTSIDE the sticky header block: a card this tall pinned to
         the top would eat the screen; only the column header sticks. #}
      <div class="budget__group-header budget__month-header" role="group" aria-label="Month summaries">
        <span class="budget__category budget__month-spacer" aria-hidden="true"></span>
        <template x-for="vm in visibleMonths()" :key="'mh-' + vm">
          <div class="budget__month-head" :class="(vm === thisMonthValue() ? 'is-current' : '') + (cardsCollapsed ? ' is-collapsed' : '')">
            <div class="budget__month-head-top">
              <span class="budget__month-head-spacer" aria-hidden="true"></span>
              <h2 class="budget__month-head-name" x-text="monthCardLabel(vm)"></h2>
              <div class="budget__month-head-tools">
              <button type="button" class="btn btn--icon budget__card-toggle"
                      @click="toggleCardsCollapsed()"
                      :aria-expanded="(!cardsCollapsed).toString()"
                      :aria-label="cardsCollapsed ? 'Expand month cards' : 'Collapse month cards to Ready to Work'"
                      :data-tip="cardsCollapsed ? 'Show the lines behind Ready to Work.' : 'Collapse to just the Ready to Work number.'">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                     :style="cardsCollapsed ? 'transform: rotate(-90deg); transition: transform 150ms ease;' : 'transition: transform 150ms ease;'">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </button>
              <button type="button" class="btn btn--icon budget__inspector-toggle"
                      x-show="inspectorDocked" x-cloak
                      :class="inspectorOpen ? 'is-active' : ''"
                      @click="setInspectorOpen(!inspectorOpen)"
                      :aria-pressed="inspectorOpen.toString()"
                      aria-label="Toggle inspector pane"
                      :data-tip="inspectorOpen ? 'Hide the inspector pane.' : 'Show the inspector pane: month overview, overspending fixes, category details.'">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="4" width="18" height="16" rx="2"/><line x1="15" y1="4" x2="15" y2="20"/>
                </svg>
              </button>
              <button type="button" class="btn btn--icon budget__month-auto"
                      @click="openAutoAssign({ kind: 'all', name: 'All categories', ids: null, month: vm })"
                      :data-tip="'Auto-assign ' + monthCardLabel(vm) + ': fill every category from goal needs, last month, or recent averages.'"
                      :aria-label="'Auto-assign ' + monthCardLabel(vm)">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M13 2L4.5 13.5h6L9 22l8.5-11.5h-6L13 2z"/>
                </svg>
              </button>
              {% call overflow(label="Month actions") %}
                <li role="none">
                  <button type="button" role="menuitem" class="overflow-menu__item"
                          @click="open = false; monthAction('copyLast', vm)">Copy last month's assigned</button>
                </li>
                <li role="none">
                  <button type="button" role="menuitem" class="overflow-menu__item"
                          @click="open = false; monthAction('zero', vm)">Set assigned to zero</button>
                </li>
                <li role="none" class="overflow-menu__sep" aria-hidden="true"></li>
                <li role="none">
                  <button type="button" role="menuitem" class="overflow-menu__item"
                          @click="open = false; monthAction('average', vm, 3)">Set to 3-month average spending</button>
                </li>
                <li role="none">
                  <button type="button" role="menuitem" class="overflow-menu__item"
                          @click="open = false; monthAction('average', vm, 6)">Set to 6-month average spending</button>
                </li>
                <li role="none">
                  <button type="button" role="menuitem" class="overflow-menu__item"
                          @click="open = false; monthAction('average', vm, 12)">Set to 12-month average spending</button>
                </li>
                <li role="none">
                  <button type="button" role="menuitem" class="overflow-menu__item"
                          @click="open = false; monthAction('goals', vm)">Fund every goal</button>
                </li>
                <li role="none" class="overflow-menu__sep" aria-hidden="true"></li>
                <li role="none">
                  <button type="button" role="menuitem" class="overflow-menu__item"
                          @click="open = false; openAutoAssign({ kind: 'all', name: 'All categories', ids: null, month: vm })">Auto-assign...</button>
                </li>
                <li role="none">
                  <button type="button" role="menuitem" class="overflow-menu__item"
                          @click="open = false; openTemplates(vm)">Templates...</button>
                </li>
                <li role="none">
                  <button type="button" role="menuitem" class="overflow-menu__item"
                          @click="open = false; openOverview()">Month overview</button>
                </li>
                <li role="none" class="overflow-menu__sep" aria-hidden="true"></li>
                <li role="none">
                  <button type="button" role="menuitem" class="overflow-menu__item"
                          @click="open = false; $store.budget.jumpToThisMonth()">Jump to this month</button>
                </li>
                <li role="none">
                  <button type="button" role="menuitem" class="overflow-menu__item"
                          @click="open = false; newGroupOpen = true; newGroupName = ''">+ New group...</button>
                </li>
                <li role="none">
                  <button type="button" role="menuitem" class="overflow-menu__item"
                          @click="open = false; $store.budget.setAllCatGroupsCollapsed(!$store.budget.allCatGroupsCollapsed())"
                          x-text="$store.budget.allCatGroupsCollapsed() ? 'Expand all groups' : 'Collapse all groups'">Collapse all groups</button>
                </li>
                <li role="none">
                  <button type="button" role="menuitem" class="overflow-menu__item"
                          @click="open = false; budgetCollapsed = !budgetCollapsed"
                          x-text="budgetCollapsed ? 'Show the category grid' : 'Hide the category grid'">Hide the category grid</button>
                </li>
                <li role="none" x-show="inspectorDocked">
                  <button type="button" role="menuitem" class="overflow-menu__item"
                          @click="open = false; setInspectorOpen(!inspectorOpen)"
                          x-text="inspectorOpen ? 'Hide the inspector pane' : 'Show the inspector pane'">Hide the inspector pane</button>
                </li>
                <li role="none">
                  <button type="button" role="menuitem" class="overflow-menu__item"
                          @click="open = false; saveCurrentView()">Save current view</button>
                </li>
              {% endcall %}
              </div>
            </div>
            <dl class="budget__month-lines" x-show="!cardsCollapsed" :aria-label="'How Ready to Work for ' + monthCardLabel(vm) + ' adds up'">
              <div>
                <dd x-text="fmtGrid(monthLines(vm).carried)"></dd>
                <dt x-text="'Left over from ' + monthCardLabel(prevMonthOf(vm), true)"></dt>
              </div>
              <div>
                <dd x-text="fmtGrid(monthLines(vm).inflow)"></dd>
                <dt x-text="'Inflow in ' + monthCardLabel(vm, true)"></dt>
              </div>
              <div>
                <dd :class="monthLines(vm).lost > 0 ? 'is-neg' : ''" x-text="fmtGrid(-monthLines(vm).lost)"></dd>
                <dt x-text="'Overspent in ' + monthCardLabel(prevMonthOf(vm), true)"></dt>
              </div>
              <div>
                <dd x-text="fmtGrid(-monthLines(vm).assigned)"></dd>
                <dt x-text="'Assigned in ' + monthCardLabel(vm, true)"></dt>
              </div>
            </dl>
            <button type="button" class="budget__month-head-rtw"
                    :class="rtaCents(vm) < 0 ? 'amount--outflow' : (rtaCents(vm) === 0 ? 'is-zero' : '')"
                    :data-tip="'Give this money a job: assign it to a category, or save it for next month.'"
                    :aria-label="'Ready to Work in ' + monthCardLabel(vm) + ': ' + formatCents(rtaCents(vm)) + '. Assign it to a category or save it for next month.'"
                    @click="openRtw(vm)">
              <span class="budget__month-head-rtw-label">Ready to Work</span>
              <span class="num" x-text="fmtGrid(rtaCents(vm))"></span>
            </button>
            <p class="budget__month-ahead" x-show="!cardsCollapsed && monthLines(vm).ahead > 0" x-cloak
               :data-tip="'Already assigned in months after ' + monthCardLabel(vm, true) + '. Ready to Work is per month here, so this is not subtracted above.'">
              Assigned ahead: <span x-text="fmtGrid(monthLines(vm).ahead)"></span>
            </p>
          </div>
        </template>
      </div>

    <div x-show="!budgetCollapsed" x-cloak>
      {# Sticky header block: an optional month strip (only when more
         than one month is visible) + the column header. Sticks below
         the site header; the offset is measured because the header's
         height varies with safe-area insets. #}
      {# Sticky header block: the column header. Sticks below the site
         header; the offset is measured because the header's height
         varies with safe-area insets. #}
      <div class="budget__headers" :style="'--budget-sticky-top:' + stickyTop() + 'px'">
        {# Desktop-only column header — at mobile each cat row carries
           its own micro-labels above the pills, so the header strip is
           redundant. Hidden via the budget__column-header class below. #}
        <div class="budget__group-header budget__column-header">
          <span class="budget__category">Category</span>
          <template x-for="vm in visibleMonths()" :key="'ch-' + vm">
            <div style="display: contents;">
              <span class="num budget__assigned" data-tip="Dollars you committed to this category this month.">Assigned</span>
              <span class="num budget__activity" data-tip="Outflows from this category this month. Inflows show as positive.">Outflow</span>
              <span class="num budget__available" data-tip="Carry-in + assigned + outflow. Pill color: green = funded, blue = positive remainder, red = overspent.">Available</span>
              <span class="budget__row-actions" aria-hidden="true"></span>
            </div>
          </template>
        </div>
      </div>

    <div>
      <template x-for="group in $store.budget.categoryGroupsView()" :key="group.group ? group.group.id : '__ungrouped'">
        <div class="budget__group cat-group">
          <div class="budget__group-header budget__group-header--row" style="background: var(--bg-elevated);"
               :data-group-id="group.group ? group.group.id : ''">
            <div class="cluster budget__category" style="gap: var(--space-2xs); min-width: 0;">
              <input type="checkbox" class="budget__bulk-check"
                     x-show="group.categories.length"
                     :checked="groupAllSelected(group)"
                     :indeterminate.camel="groupSomeSelected(group)"
                     @change="toggleGroupSelected(group)"
                     :aria-label="'Select all categories in ' + (group.group?.name || 'Other')"
                     :data-tip="'Select / deselect every category in ' + (group.group?.name || 'Other categories') + ' for bulk actions.'">
              <div class="budget__group-title">
              <button type="button" class="group-toggle"
                      @click="group.group && $store.budget.toggleCategoryGroupCollapsed(group.group.id)"
                      :aria-expanded="group.group && !$store.budget.isCatGroupCollapsed(group.group.id) ? 'true' : 'false'"
                      :disabled="!group.group">
                <span class="group-toggle__chevron" :class="group.group && $store.budget.isCatGroupCollapsed(group.group.id) ? 'is-collapsed' : ''" aria-hidden="true">&#9662;</span>
                <strong x-text="group.group ? group.group.name : 'Other categories'"></strong>
              </button>
              {# Rolled-up trackers under the group name: goals weighted by
                 target, cuts as dollars saved over dollars planned. #}
              <div class="goal-bar goal-bar--thin goal-bar--group"
                   x-show="groupGoal(group).count" x-cloak
                   :class="groupGoal(group).pct >= 100 ? 'goal-bar--funded' : (groupGoal(group).pct >= 50 ? 'goal-bar--accent' : 'goal-bar--muted')"
                   :style="{ '--pct': groupGoal(group).pct }"
                   :data-tip="groupGoal(group).tip"
                   role="progressbar" :aria-label="groupGoal(group).tip"
                   :aria-valuenow="groupGoal(group).pct" aria-valuemin="0" aria-valuemax="100">
                <svg class="goal-bar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="1" fill="currentColor"/></svg>
                <span class="goal-bar__track"><span class="goal-bar__fill"></span></span>
              </div>
              <div class="goal-bar goal-bar--thin goal-bar--group goal-bar--cut"
                   x-show="groupCut(group).count" x-cloak
                   :class="groupCut(group).pct >= 100 ? 'goal-bar--funded' : ''"
                   :style="{ '--pct': groupCut(group).pct }"
                   :data-tip="groupCut(group).tip"
                   role="progressbar" :aria-label="groupCut(group).tip"
                   :aria-valuenow="groupCut(group).pct" aria-valuemin="0" aria-valuemax="100">
                <svg class="goal-bar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" y1="4" x2="8.12" y2="15.88"/><line x1="14.47" y1="14.48" x2="20" y2="20"/><line x1="8.12" y1="8.12" x2="12" y2="12"/></svg>
                <span class="goal-bar__track"><span class="goal-bar__fill"></span></span>
              </div>
              </div>
            </div>
            {# Group totals stay as plain bold tabular numerals — no
               pill chrome — so they read as summary lines rather
               than echoing the per-cat pill row. Outflow keeps its
               button affordance but loses the pill border at the
               group level (.budget__group-header override below). #}
            <template x-for="vm in visibleMonths()" :key="'gt-' + vm">
              <div style="display: contents;">
                <span class="num budget__group-total budget__assigned" x-text="fmtGrid(groupTotalAssigned(group.categories, vm))"></span>
                <span class="num budget__group-total budget__activity">
                  <button type="button" class="budget__activity-btn budget__activity-btn--group"
                          :disabled="groupTotalActivity(group.categories, vm) === 0"
                          @click="openActivity({ kind: 'group', id: group.group?.id || '__ungrouped', name: group.group ? group.group.name : 'Other categories', categoryIds: group.categories.map(c => c.id), month: vm })"
                          :data-tip="groupTotalActivity(group.categories, vm) === 0 ? '' : ('Click to see every transaction across ' + (group.group ? group.group.name : 'Other categories') + ' in ' + monthShortLabel(vm) + '.')"
                          x-text="fmtGrid(groupTotalActivity(group.categories, vm))"></button>
                </span>
                <span class="num budget__group-total budget__available"
                      :class="groupTotalAvailable(group.categories, vm) < 0 ? 'budget__group-total--neg' : ''"
                      x-text="fmtGrid(groupTotalAvailable(group.categories, vm))"></span>
                {# Fillers hold the per-month kebab slot for every month
                   but the last; the group kebab below takes the last
                   slot itself, so it sits in the same column as the
                   category kebabs instead of one column further right
                   (which also squeezed the group's numbers out of line
                   with the rows beneath). Single-month mode maps every
                   row-actions element onto the one `actions` area, so
                   the missing filler changes nothing there. #}
                <span class="budget__row-actions budget__row-actions--filler" aria-hidden="true"
                      x-show="vm !== visibleMonths()[visibleMonths().length - 1]"></span>
              </div>
            </template>
            {# Group kebab: last per-month slot in multi-month, the
               `actions` area in single-month. All group-level actions
               live here. #}
            <div class="budget__row-actions" x-show="group.group" x-cloak>
              {% call overflow(label="Group actions") %}
                <li role="none">
                  <button type="button" role="menuitem" class="overflow-menu__item"
                          @click="open = false; openAutoAssign({ kind: 'group', name: group.group.name, ids: group.categories.map(c => c.id) })">Auto-assign group</button>
                </li>
                <li role="none">
                  <button type="button" role="menuitem" class="overflow-menu__item"
                          @click="open = false; addCategoryTo(group.group)">Add category</button>
                </li>
                <li role="none">
                  <button type="button" role="menuitem" class="overflow-menu__item"
                          @click="open = false; openRenameGroup(group.group)">Rename group</button>
                </li>
                <li role="none" class="overflow-menu__sep" aria-hidden="true"></li>
                <li role="none">
                  <button type="button" role="menuitem" class="overflow-menu__item"
                          @click="open = false; keyboardMoveGroup(group.group, -1)">Move group up</button>
                </li>
                <li role="none">
                  <button type="button" role="menuitem" class="overflow-menu__item"
                          @click="open = false; keyboardMoveGroup(group.group, 1)">Move group down</button>
                </li>
                <li role="none" class="overflow-menu__sep" aria-hidden="true"></li>
                <li role="none">
                  <button type="button" role="menuitem" class="overflow-menu__item"
                          @click="open = false; groupClearAssigned(group)">Clear assigned</button>
                </li>
                <li role="none">
                  <button type="button" role="menuitem" class="overflow-menu__item"
                          @click="open = false; groupClearAvailable(group)">Clear available</button>
                </li>
                <li role="none" class="overflow-menu__sep" aria-hidden="true"></li>
                <li role="none">
                  <button type="button" role="menuitem" class="overflow-menu__item overflow-menu__item--danger"
                          @click="open = false; deleteGroup(group.group)">Delete group</button>
                </li>
              {% endcall %}
            </div>
          </div>

          <div x-show="!(group.group && $store.budget.isCatGroupCollapsed(group.group.id))" x-cloak>
            <div>
              <template x-for="c in group.categories" :key="c.id">
                <div class="budget__row cat-row"
                     :data-cat-id="c.id"
                     :class="isCatSelected(c.id) ? 'budget__row--selected' : ''">
                  <div class="budget__category">
                    <div class="budget__category-row">
                      <input type="checkbox" class="budget__bulk-check"
                             :checked="isCatSelected(c.id)"
                             @change="toggleCatSelected(c.id)"
                             :aria-label="'Select ' + c.name + ' for bulk actions'"
                             :data-tip="'Select this category for bulk Clear assigned / Clear available.'">
                      {# Marks come first, in a fixed-width slot, so every
                         name starts at the same x whether or not the row
                         has a goal, a cut, or a note. Order: goal, cut, note. #}
                      <span class="budget__cat-ind">
                        <button type="button" class="note-ind"
                                x-show="hasNotes(c)" x-cloak
                                :data-tip="notesTip(c)"
                                :aria-label="'Note on ' + c.name + ': ' + notesTip(c)"
                                @click="openNotes(c)">
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9l-6-6z"/><path d="M14 3v6h6"/></svg>
                        </button>
                      </span>
                      <button type="button" class="budget__cat-name budget__cat-name--btn"
                              @click="selectCategory(c)"
                              :data-tip="'Open ' + c.name + ' in the inspector: breakdown, notes, goal, recent activity.'"
                              x-text="c.name"></button>
                    </div>
                    {# Progress under the name: a hairline per tracker. Goal in
                       the goal colours, cut in amber; both go green when met. #}
                    <div class="goal-bar goal-bar--thin"
                         x-show="$store.budget.findGoal(c.id)" x-cloak
                         :class="goalBarClass(c.id)"
                         :style="{ '--pct': goalPercent(c.id) }"
                         :data-tip="goalBarTooltip(c.id)"
                         role="progressbar"
                         :aria-label="'Goal progress for ' + c.name"
                         :aria-valuenow="goalPercent(c.id)"
                         :aria-valuetext="goalPercent(c.id) + '% of goal for ' + c.name + '. ' + goalLabel(c.id)"
                         aria-valuemin="0" aria-valuemax="100">
                      <svg class="goal-bar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="1" fill="currentColor"/></svg>
                      <span class="goal-bar__track"><span class="goal-bar__fill"></span></span>
                    </div>
                    <div class="goal-bar goal-bar--thin goal-bar--cut"
                         x-show="$store.budget.cutForCategory(c.id)" x-cloak
                         :class="cutPercent(c.id) >= 100 ? 'goal-bar--funded' : ''"
                         :style="{ '--pct': cutPercent(c.id) }"
                         :data-tip="cutTooltip(c.id)"
                         role="progressbar"
                         :aria-label="'Planned cut progress for ' + c.name"
                         :aria-valuenow="cutPercent(c.id)"
                         :aria-valuetext="cutPercent(c.id) + '% of this month\'s planned cut realized for ' + c.name"
                         aria-valuemin="0" aria-valuemax="100">
                      <svg class="goal-bar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" y1="4" x2="8.12" y2="15.88"/><line x1="14.47" y1="14.48" x2="20" y2="20"/><line x1="8.12" y1="8.12" x2="12" y2="12"/></svg>
                      <span class="goal-bar__track"><span class="goal-bar__fill"></span></span>
                    </div>
                  </div>
                  {# One (Assigned / Outflow / Available) cell triplet per
                     visible month. The wrapper is display:contents so the
                     cells stay direct grid items: single-month keeps the
                     named-area layout, multi-month auto-places in DOM
                     order. Every cell carries data-month. #}
                  <template x-for="vm in visibleMonths()" :key="'c-' + c.id + '-' + vm">
                    <div style="display: contents;">
                      <div class="budget__assigned" data-label="Assigned" :data-month="vm"
                           :tabindex="cellTabIndex(c.id, vm)"
                           @focus="setFocusCell(c.id, vm)"
                           @keydown="onCellKeydown(c, vm, $event)"
                           :aria-label="c.name + ', ' + monthShortLabel(vm) + ': assigned ' + formatCents($store.budget.assignedFor(c.id, vm)) + '. Press Enter to edit.'">
                        {# This month's note, and only this month's: it lives
                           in the month's own column, not in a running list
                           on the name. #}
                        <button type="button" class="note-ind note-ind--month" tabindex="-1"
                                x-show="$store.budget.monthNote(c.id, vm)" x-cloak
                                :data-tip="monthCardLabel(vm, true) + ': ' + $store.budget.monthNote(c.id, vm)"
                                :aria-label="'Note for ' + c.name + ' in ' + monthCardLabel(vm) + ': ' + $store.budget.monthNote(c.id, vm)"
                                @click.stop="openNotes(c)">
                          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9l-6-6z"/><path d="M14 3v6h6"/></svg>
                        </button>
                        {# select() on focus: the cell always holds a value, so
                           the first keystroke replaces the amount. Arrow keys
                           or a second click still place a caret. #}
                        <template x-if="!assignReadOnly(c)">
                          <input type="text" inputmode="decimal"
                                 data-touch="compact" tabindex="-1"
                                 :data-month="vm"
                                 :aria-label="'Assigned for ' + c.name + ', ' + monthShortLabel(vm)"
                                 :value="formatAssigned($store.budget.assignedFor(c.id, vm))"
                                 data-tip="Type an amount, or an expression like 100+25."
                                 @focus="$event.target.value = formatPlain($store.budget.assignedFor(c.id, vm)); $event.target.select()"
                                 @blur="onAssignBlur(c, vm, $event)"
                                 @keydown.enter="onAssignKeyEnter($event)"
                                 @keydown.escape.stop="onAssignKeyEscape($event)">
                        </template>
                        {# Income categories are funded by their transactions
                           and payment pools by Move money — auto-assign and
                           the bulk helpers already skip both, so an editable
                           cell here was a promise the rest of the page
                           refused to honor. #}
                        <template x-if="assignReadOnly(c)">
                          <span class="budget__assigned-locked num"
                                :data-tip="$store.budget.isPaymentCategory(c.id)
                                  ? 'Payment pools are funded with Move money, not direct assignment.'
                                  : 'Income categories receive money from transactions. Assign it from Ready to Work instead.'"
                                x-text="formatAssigned($store.budget.assignedFor(c.id, vm))"></span>
                        </template>
                      </div>
                      <div class="budget__activity" data-label="Outflow" :data-month="vm">
                        <button type="button" class="budget__activity-btn"
                                :disabled="$store.budget.activityFor(c.id, vm) === 0"
                                @click="selectCategory(c, vm)"
                                :data-tip="$store.budget.activityFor(c.id, vm) === 0 ? '' : ('Inspect ' + c.name + ' in ' + monthShortLabel(vm) + ' - recent transactions show in the pane.')"
                                x-text="fmtGrid($store.budget.activityFor(c.id, vm))"></button>
                      </div>
                      <div class="budget__available" data-label="Available" :data-month="vm">
                        <button type="button"
                                class="available-pill available-pill--btn"
                                :class="availablePillClass(c.id, vm)"
                                @click="selectCategory(c, vm)"
                                :aria-label="'Inspect ' + c.name + ' for ' + monthShortLabel(vm) + ' (available: ' + formatCents(categoryAvailable(c.id, vm)) + ')'"
                                data-tip="Open in the inspector - move money, notes, goal, activity."
                                x-text="fmtGrid(categoryAvailable(c.id, vm))"></button>
                      </div>
                      {# Month-scoped kebab - one per month column, so
                         every visible month edits from its own menu. #}
                      <div class="budget__row-actions" :data-month="vm">
                        <template x-if="!$store.budget.isPaymentCategory(c.id)">
                          {% call overflow(label="Category actions") %}
                            <li role="none">
                              <button type="button" role="menuitem" class="overflow-menu__item"
                                      @click="open = false; selectCategory(c, vm)"
                                      x-text="'Inspect ' + monthShortLabel(vm) + '…'">Inspect…</button>
                            </li>
                            <li role="none">
                              <button type="button" role="menuitem" class="overflow-menu__item"
                                      @click="open = false; openAutoAssign({ kind: 'category', name: c.name, id: c.id, month: vm })">Auto-assign…</button>
                            </li>
                            <li role="none">
                              <button type="button" role="menuitem" class="overflow-menu__item"
                                      @click="open = false; openNotes(c)">Notes…</button>
                            </li>
                            <li role="none" class="overflow-menu__sep" aria-hidden="true"></li>
                            <li role="none">
                              <button type="button" role="menuitem" class="overflow-menu__item"
                                      @click="open = false; catClearAssigned(c, vm)">Clear assigned</button>
                            </li>
                            <li role="none">
                              <button type="button" role="menuitem" class="overflow-menu__item"
                                      @click="open = false; catClearAvailable(c, vm)">Clear available</button>
                            </li>
                            <li role="none" class="overflow-menu__sep" aria-hidden="true"></li>
                            <li role="none">
                              <button type="button" role="menuitem" class="overflow-menu__item"
                                      @click="open = false; keyboardMoveCat(c, group, -1)">Move up</button>
                            </li>
                            <li role="none">
                              <button type="button" role="menuitem" class="overflow-menu__item"
                                      @click="open = false; keyboardMoveCat(c, group, 1)">Move down</button>
                            </li>
                            <li role="none" class="overflow-menu__sep" aria-hidden="true"></li>
                            <li role="none">
                              <button type="button" role="menuitem" class="overflow-menu__item overflow-menu__item--danger"
                                      @click="open = false; deleteCategoryRow(c)">Delete category</button>
                            </li>
                          {% endcall %}
                        </template>
                      </div>
                    </div>
                  </template>
                </div>
              </template>
            </div>

            <p x-show="!group.categories.length" x-cloak style="padding: var(--space-sm); color: var(--fg-muted); font-size: var(--fs-sm);">
              No categories in this group yet. Use the group menu (⋮) to add one.
            </p>
          </div>
        </div>
      </template>
    </div>

    </div> {# /budgetCollapsed wrapper #}

    {# Total budget — bottom summary row matching the columns above. #}
    {# Collapsed grid: one clean summary CARD per visible month.
       (The grid-flow total row drifted cells at higher month counts
       and read as a wall of uppercase labels - cards cannot drift.) #}
    <div class="budget__mcards" x-show="budgetCollapsed" x-cloak>
      <template x-for="vm in visibleMonths()" :key="'sum-' + vm">
        <article class="budget__mcard">
          <h3 class="budget__mcard-title" x-text="monthShortLabel(vm)"></h3>
          <dl class="budget__mcard-stats">
            <div><dt>Assigned</dt>
              <dd x-text="formatCents($store.budget.totalAssignedInMonth(vm))"></dd></div>
            <div><dt>Outflow</dt>
              <dd :class="monthlyOutflowTotal(vm) < 0 ? 'amount--outflow' : ''"
                  x-text="formatCents(monthlyOutflowTotal(vm))"></dd></div>
            <div><dt>Available</dt>
              <dd :class="monthlyAvailableTotal(vm) < 0 ? 'amount--outflow' : 'amount--inflow'"
                  x-text="formatCents(monthlyAvailableTotal(vm))"></dd></div>
            <div><dt>Ready to Work</dt>
              <dd :class="rtaCents(vm) < 0 ? 'amount--outflow' : ''"
                  x-text="formatCents(rtaCents(vm))"></dd></div>
          </dl>
        </article>
      </template>
    </div>

    <div class="budget__group-header budget__total-row" aria-label="Totals for the visible months"
         x-show="!budgetCollapsed" x-cloak>
      <div class="budget__total-label budget__category">
        <span class="budget__total-eyebrow">Month total</span>
        <strong x-text="effectiveMonthCount() > 1 ? (monthShortLabel($store.budget.currentMonth) + ' +' + (effectiveMonthCount() - 1)) : monthHeaderLabel()"></strong>
      </div>
      <template x-for="vm in visibleMonths()" :key="'tt-' + vm">
        <div style="display: contents;">
          <span class="num budget__assigned">
            <span class="budget__total-mini-label" x-text="effectiveMonthCount() > 1 ? monthShortLabel(vm) + ' assigned' : 'Assigned'"></span>
            <span class="budget__total-value"
                  x-text="fmtGrid($store.budget.totalAssignedInMonth(vm))"></span>
          </span>
          <span class="num budget__activity">
            <span class="budget__total-mini-label">Outflow</span>
            <button type="button" class="budget__activity-btn budget__total-value"
                    :disabled="monthlyOutflowTotal(vm) === 0"
                    @click="openActivity({ kind: 'all', id: '__all', name: 'All categories', month: vm })"
                    :data-tip="monthlyOutflowTotal(vm) === 0 ? '' : ('Click to see every transaction in ' + monthShortLabel(vm) + '.')"
                    :class="monthlyOutflowTotal(vm) < 0 ? 'amount--outflow' : ''"
                    x-text="fmtGrid(monthlyOutflowTotal(vm))"></button>
          </span>
          <span class="num budget__available">
            <span class="budget__total-mini-label">Available</span>
            <span class="budget__total-value"
                  :class="monthlyAvailableTotal(vm) < 0 ? 'amount--outflow' : 'amount--inflow'"
                  x-text="fmtGrid(monthlyAvailableTotal(vm))"></span>
          </span>
          <span class="budget__row-actions" aria-hidden="true"></span>
        </div>
      </template>
    </div>
    {# Hidden categories - the way back. Hiding used to be a one-way
       door: categoryGroupsView filters hidden and no surface listed
       them again. #}
    <div class="budget__hidden" x-show="$store.budget.hiddenCategories().length" x-cloak>
      <button type="button" class="budget__hidden-toggle"
              @click="hiddenOpen = !hiddenOpen"
              :aria-expanded="hiddenOpen.toString()"
              :aria-label="'Hidden categories (' + $store.budget.hiddenCategories().length + ')'">
        <span class="group-toggle__chevron" :class="hiddenOpen ? '' : 'is-collapsed'" aria-hidden="true">&#9662;</span>
        Hidden categories (<span x-text="$store.budget.hiddenCategories().length"></span>)
      </button>
      <ul class="budget__hidden-list" x-show="hiddenOpen" x-cloak>
        <template x-for="hc in $store.budget.hiddenCategories()" :key="'hid-' + hc.id">
          <li>
            <span class="budget__hidden-name">
              <span x-text="hc.name"></span>
              <span class="budget__hidden-group" x-show="hc.groupName" x-text="hc.groupName"></span>
            </span>
            <span class="num" x-text="formatCents(categoryAvailable(hc.id))"></span>
            <button type="button" class="btn btn--secondary btn--sm"
                    data-tip="Bring this category back into the grid."
                    @click="$store.budget.setCategoryHidden(hc.id, false); $store.budget.pushToast(hc.name + ' unhidden.')">Unhide</button>
          </li>
        </template>
      </ul>
    </div>
  </section>
  {% include "partials/budget-inspector.njk" %}
  </div> {# /budget-layout #}

  {# Credit-card payment-pool cards. Show one card per credit account with
     a pill of the dollars currently assigned for paying it down vs. the
     amount of debt currently owed. Surfaces the at-a-glance "do I have
     enough set aside to cover this card" answer. #}
  <section class="pool-grid" x-show="hasCategories && paymentPools().length" x-cloak>
    <header class="pool-grid__header">
      <h2 class="pool-grid__title">Credit Card Payment Pools</h2>
      <p class="pool-grid__sub">How much you've set aside in each card's payment category vs. the balance owed.</p>
    </header>
    <div class="pool-grid__cards">
      <template x-for="p in paymentPools()" :key="p.accountId">
        <article class="pool-card" :class="poolCardClass(p)">
          <header class="pool-card__head">
            <h3 class="pool-card__name" x-text="p.accountName"></h3>
            <p class="pool-card__role">Payment Pool</p>
          </header>
          <div class="pool-card__amount">
            <span class="available-pill"
                  :class="poolPillClass(p)"
                  x-text="formatCents(p.pool)"></span>
          </div>
          <div class="pool-card__progress-wrap">
            <div class="pool-card__progress"
                 :data-tip="poolCoverageLabel(p)">
              <div class="pool-card__progress-bar"
                   :class="poolBarClass(p)"
                   :style="'width: ' + Math.min(100, p.coveragePct) + '%;'"
                   role="progressbar"
                   :aria-valuenow="p.coveragePct"
                   aria-valuemin="0"
                   aria-valuemax="100"
                   :aria-label="poolCoverageLabel(p)"></div>
            </div>
            <span class="pool-card__pct"
                  :class="p.coveragePct >= 100 ? 'pool-card__pct--full' : ''"
                  x-text="p.coveragePct >= 100 ? '✓ 100%' : (p.coveragePct + '%')"></span>
          </div>
          <p class="pool-card__hint" x-text="poolCoverageLabel(p)"></p>
        </article>
      </template>
    </div>
  </section>

  {# Floating bulk-actions bar — visible only when at least one category
     is selected. Clear assigned / Clear available apply to the
     selection; Cancel deselects everything. #}
  <div class="bulk-actions-bar"
       x-show="selectedCatIds.length && !(inspectorDocked && inspectorOpen)"
       x-cloak role="region" aria-label="Bulk actions">
    <div class="bulk-actions-bar__count">
      <strong x-text="selectedCatIds.length"></strong>
      <span x-text="selectedCatIds.length === 1 ? 'category selected' : 'categories selected'"></span>
    </div>
    <div class="cluster" style="gap: var(--space-2xs);">
      <button type="button" class="btn btn--primary btn--sm" @click="bulkAutoAssign()"
              data-tip="Open the auto-assign strategy picker for every selected category.">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="vertical-align: -2px; margin-right: 4px;">
          <path d="M13 2L4.5 13.5h6L9 22l8.5-11.5h-6L13 2z"/>
        </svg>
        Auto-assign
      </button>
      {# Secondary bulk actions inline on desktop, kebab on mobile so
         the count + primary action always fit one line at 360px. #}
      <span class="bulk-actions-bar__more bulk-actions-bar__more--desktop">
        <button type="button" class="btn btn--secondary btn--sm" @click="bulkClearAssigned('selection')"
                data-tip="Reset Assigned to $0 for every selected category in this month.">Clear assigned</button>
        <button type="button" class="btn btn--secondary btn--sm" @click="bulkClearAvailable('selection')"
                data-tip="Push Available to $0 for every selected category — pulls money back to Ready to Work.">Clear available</button>
      </span>
      <span class="bulk-actions-bar__more bulk-actions-bar__more--mobile">
        {% call overflow(label="More bulk actions") %}
          <li role="none">
            <button type="button" role="menuitem" class="overflow-menu__item"
                    @click="open = false; bulkClearAssigned('selection')">Clear assigned</button>
          </li>
          <li role="none">
            <button type="button" role="menuitem" class="overflow-menu__item"
                    @click="open = false; bulkClearAvailable('selection')">Clear available</button>
          </li>
        {% endcall %}
      </span>
      <button type="button" class="btn btn--ghost btn--sm" @click="clearSelection()"
              data-tip="Deselect everything.">Cancel</button>
    </div>
  </div>

  {# Saved budget templates modal — save current month's assigned
     values as a named template, or apply a saved template to the
     current month. Templates live on the profile under
     `budgetTemplates`. #}
  {# Notes modal - the category-wide note plus one note per visible
     month. Reached from the row's note icon or any month kebab. #}
  <template x-if="notesCat">
    <div class="modal-backdrop" @click.self="notesCat = null"
         @keydown.escape.window="notesCat = null">
      <div class="modal modal--sm" role="dialog" aria-modal="true" aria-labelledby="bd-notes-title">
        <button class="modal__close" type="button" @click="notesCat = null" aria-label="Close">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="6" y1="18" x2="18" y2="6"/></svg>
        </button>
        <h2 class="modal__title" id="bd-notes-title">
          Notes · <span x-text="notesCat?.name"></span>
        </h2>
        <form @submit.prevent="saveNotes()">
          <div class="field">
            <label class="field__label" for="bd-note-cat">Category note</label>
            <textarea class="input" id="bd-note-cat" rows="2" x-model="noteForm.category"
                      placeholder="Applies to every month"></textarea>
          </div>
          <template x-for="vm in visibleMonths()" :key="'nf-' + vm">
            <div class="field">
              <label class="field__label" :for="'bd-note-' + vm"
                     x-text="monthShortLabel(vm) + ' note'"></label>
              <textarea class="input" :id="'bd-note-' + vm" rows="2"
                        x-model="noteForm.months[vm]"
                        :placeholder="'Just for ' + monthShortLabel(vm)"></textarea>
            </div>
          </template>
          <div class="form-actions">
            <button class="btn btn--primary" type="submit">Save notes</button>
            <button class="btn btn--ghost" type="button" @click="notesCat = null">Cancel</button>
          </div>
        </form>
      </div>
    </div>
  </template>

  {# Ready to Work modal - the headline number's one job: give the
     money a job. Assign it to a category this month, or save it for
     next month by assigning it to a category THERE (money nobody
     assigns rolls forward on its own; this is for people who want to
     decide now). #}
  <template x-if="rtwOpen">
  <div class="modal-backdrop" @click.self="rtwOpen = false" @keydown.escape.window="rtwOpen = false">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="rtw-title">
      <button class="modal__close" type="button" @click="rtwOpen = false" aria-label="Close">&times;</button>
      <h2 class="modal__title" id="rtw-title">
        Ready to Work: <span x-text="formatCents(rtaCents(rtwForm.month))"></span>
      </h2>
      <p class="modal__lead" style="color: var(--fg-muted); margin-top: 0;">
        <span x-text="monthCardLabel(rtwForm.month)"></span> has this much inflow that no category has claimed.
        <span x-show="rtaCents(rtwForm.month) < 0" x-cloak>It is negative: more was assigned than came in. Pull assignments back until it reaches zero.</span>
      </p>
      <form @submit.prevent="submitRtw()" class="form-stack">
        <div class="field">
          <span class="field__label">Where should it go?</span>
          <div class="cluster" style="gap: var(--space-2xs);">
            <label class="btn btn--sm" :class="rtwForm.target === 'this' ? 'btn--primary' : 'btn--ghost'">
              <input type="radio" class="visually-hidden" value="this" x-model="rtwForm.target">
              A category in <span x-text="monthCardLabel(rtwForm.month, true)"></span>
            </label>
            <label class="btn btn--sm" :class="rtwForm.target === 'next' ? 'btn--primary' : 'btn--ghost'">
              <input type="radio" class="visually-hidden" value="next" x-model="rtwForm.target">
              Save for <span x-text="monthCardLabel(nextMonthOf(rtwForm.month), true)"></span>
            </label>
          </div>
        </div>
        <div class="field">
          <label class="field__label" for="rtw-cat">Category</label>
          <select class="select" id="rtw-cat" x-model="rtwForm.categoryId" required>
            <option value="">Choose a category...</option>
            <template x-for="opt in rtwCategoryOptions()" :key="'rtw-' + opt.id">
              <option :value="opt.id" x-text="opt.label + '  (' + formatCents(opt.available) + ' available)'"></option>
            </template>
          </select>
          <p class="field__hint" x-show="rtwForm.target === 'next'" x-cloak>
            The amount is added to that category's Assigned in <span x-text="monthCardLabel(nextMonthOf(rtwForm.month), true)"></span>, so it is spoken for before the month starts.
          </p>
        </div>
        <div class="field">
          <label class="field__label" for="rtw-amount">Amount</label>
          <input class="input" id="rtw-amount" type="text" inputmode="decimal" x-model="rtwForm.amount"
                 placeholder="0.00" data-tip="Type an amount, or an expression like 100+25.">
          <p class="field__hint">Defaults to all of it. Assign less to keep some unassigned.</p>
        </div>
        <div class="form-actions">
          <button class="btn btn--primary" type="submit" :disabled="!rtwForm.categoryId">
            <span x-text="rtwForm.target === 'next' ? 'Save for next month' : 'Assign'"></span>
          </button>
          <button class="btn btn--ghost" type="button" @click="rtwOpen = false; openOverview()">Open month overview</button>
          <button class="btn btn--ghost" type="button" @click="rtwOpen = false">Cancel</button>
        </div>
      </form>
    </div>
  </div>
  </template>

  <template x-if="templatesOpen">
  <div class="modal-backdrop" @click.self="templatesOpen = false" @keydown.escape.window="templatesOpen = false">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="tpl-title" style="max-width: 560px;">
      <button class="modal__close" type="button" @click="templatesOpen = false" aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="6" y1="18" x2="18" y2="6"/></svg>
      </button>
      <h2 class="modal__title" id="tpl-title">Budget templates</h2>
      <p style="color: var(--fg-muted);">
        Save the current month's assigned values as a named template,
        then apply it to any other month with one click. Categories that
        no longer exist when you apply are silently skipped.
      </p>

      <div class="field" style="margin-top: var(--space-sm);">
        <label class="field__label" for="tpl-name">Save current month as template</label>
        <div class="cluster" style="gap: var(--space-2xs); flex-wrap: nowrap;">
          <input class="input" id="tpl-name" type="text" x-model="templateNewName"
                 placeholder="e.g. Standard month" autocomplete="off" style="flex: 1 1 auto; min-width: 0;">
          <button class="btn btn--primary" type="button"
                  :disabled="!templateNewName.trim()"
                  @click="saveTemplate()">Save</button>
        </div>
        <p class="field__hint">
          Captures every non-zero assignment in
          <strong x-text="monthHeaderLabel(templateMonth)"></strong>.
        </p>
      </div>

      <h4 style="margin-top: var(--space-md);">Saved templates</h4>
      <p x-show="!$store.budget.listBudgetTemplates().length" x-cloak style="color: var(--fg-muted);">
        No templates saved yet.
      </p>
      <ul x-show="$store.budget.listBudgetTemplates().length" x-cloak class="template-list" style="list-style: none; padding: 0; margin: var(--space-2xs) 0 0;">
        <template x-for="tpl in $store.budget.listBudgetTemplates()" :key="tpl.id">
          <li class="template-list__item" style="display: flex; align-items: center; gap: var(--space-2xs); justify-content: space-between; padding: var(--space-2xs) 0; border-bottom: 1px solid var(--border-soft);">
            <div style="min-width: 0;">
              <p style="margin: 0; font-weight: 600;" x-text="tpl.name"></p>
              <p style="margin: 0; color: var(--fg-muted); font-size: var(--fs-xs);"
                 x-text="Object.keys(tpl.assigned || {}).length + ' categories · saved ' + new Date(tpl.createdAt).toLocaleDateString()"></p>
            </div>
            <div class="cluster" style="gap: var(--space-2xs); flex-shrink: 0;">
              <button class="btn btn--primary btn--sm" type="button"
                      @click="applyTemplate(tpl.id)"
                      :data-tip="'Overwrite assignments in ' + monthHeaderLabel(templateMonth) + ' with this template.'">Apply</button>
              <button class="btn btn--ghost btn--sm" type="button"
                      @click="deleteTemplate(tpl.id, tpl.name)"
                      data-tip="Delete this template.">Delete</button>
            </div>
          </li>
        </template>
      </ul>

      <div class="form-actions" style="margin-top: var(--space-md);">
        <button class="btn btn--ghost" type="button" @click="templatesOpen = false">Close</button>
      </div>
    </div>
  </div>
  </template>

  {# The nine grid modals live OUTSIDE both the hasCategories section
     and the budgetCollapsed wrapper: their triggers stay visible when
     the grid is collapsed, and the empty-state CTA opens the New-group
     modal on a profile with zero categories. Rendered with x-if so a
     closed dialog's controls stay out of axe and the touch census. #}
    

    {# Auto-assign modal — pick a strategy, see a per-strategy preview
       total, then apply. Each strategy walks every non-payment
       category and sets its Assigned for the active month. #}
    <template x-if="autoAssignOpen">
    <div class="modal-backdrop" @click.self="autoAssignOpen = false"
         @keydown.escape.window="autoAssignOpen = false">
      <div class="modal auto-assign" role="dialog" aria-modal="true" aria-labelledby="bd-auto-title">
        <button class="modal__close" type="button" @click="autoAssignOpen = false" aria-label="Close">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="6" y1="18" x2="18" y2="6"/></svg>
        </button>
        <header class="auto-assign__header">
          <p class="eyebrow">Auto-assign · <span x-text="autoAssignScope.name"></span></p>
          <h2 class="modal__title" id="bd-auto-title" style="margin: 0;">
            Fill <span x-text="monthHeaderLabel()"></span> from a template
          </h2>
          <p class="auto-assign__lead">
            Pick a strategy.
            <span x-show="autoAssignScope.kind === 'all'">Categories that don't apply are left unchanged.</span>
            <span x-show="autoAssignScope.kind === 'group'">Only categories in <strong x-text="autoAssignScope.name"></strong> are touched.</span>
            <span x-show="autoAssignScope.kind === 'category'">Only the <strong x-text="autoAssignScope.name"></strong> category is touched.</span>
            <span x-show="autoAssignScope.kind === 'selection'">Only the <strong x-text="autoAssignScope.name"></strong> are touched.</span>
            You can tweak any row after.
          </p>
        </header>

        <ul class="auto-assign__list">
          <template x-for="opt in autoAssignStrategies()" :key="opt.id">
            <li>
              <button type="button"
                      class="auto-assign__opt"
                      :class="{
                        'is-selected': autoAssignChoice === opt.id,
                        'is-disabled': opt.disabled
                      }"
                      @click="!opt.disabled && (autoAssignChoice = opt.id)"
                      :disabled="opt.disabled"
                      :aria-pressed="(autoAssignChoice === opt.id).toString()">
                <div class="auto-assign__opt-head">
                  <span class="auto-assign__opt-radio" aria-hidden="true">
                    <svg x-show="autoAssignChoice === opt.id" width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="8"/></svg>
                  </span>
                  <span class="auto-assign__opt-label" x-text="opt.label"></span>
                  <span class="auto-assign__opt-total"
                        :class="opt.disabled ? 'auto-assign__opt-total--muted' : (opt.preview < 0 ? 'amount--outflow' : 'amount--inflow')"
                        x-text="opt.disabled ? '—' : formatCents(opt.preview)"></span>
                </div>
                <p class="auto-assign__opt-hint" x-text="opt.hint"></p>
              </button>
            </li>
          </template>
        </ul>

        <div class="auto-assign__footer">
          <p class="auto-assign__count" x-show="autoAssignChoice" x-cloak>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            <span x-text="autoAssignSummary()"></span>
          </p>
          <p class="auto-assign__count auto-assign__count--placeholder" x-show="!autoAssignChoice">
            Select a strategy above to preview the impact.
          </p>
        </div>

        <div class="form-actions">
          <button class="btn btn--primary" type="button"
                  :disabled="!autoAssignChoice"
                  @click="applyAutoAssign()"
                  data-tip="Apply the selected strategy to this month's Assigned column.">Apply auto-assign</button>
          <button class="btn btn--ghost" type="button" @click="autoAssignOpen = false">Cancel</button>
        </div>
      </div>
    </div>
    </template>

    {# Add-group modal — fired from the toolbar "+ Group" button. #}
    <template x-if="newGroupOpen">
    <div class="modal-backdrop" @click.self="newGroupOpen = false" @keydown.escape.window="newGroupOpen = false">
      <div class="modal modal--sm" role="dialog" aria-modal="true" aria-labelledby="bd-group-title">
        <h2 class="modal__title" id="bd-group-title">New category group</h2>
        <p style="color: var(--fg-muted); margin: 0 0 var(--space-sm);">
          Groups organize the budget. Examples: Monthly bills, Subscriptions, Reserves.
        </p>
        <form @submit.prevent="submitNewGroup()">
          <div class="field">
            <label class="field__label" for="bd-group-name">Group name</label>
            <input class="input" id="bd-group-name" type="text" x-model="newGroupName" required autofocus>
          </div>
          <div class="form-actions">
            <button class="btn btn--primary" type="submit">Create group</button>
            <button class="btn btn--ghost" type="button" @click="newGroupOpen = false">Cancel</button>
          </div>
        </form>
      </div>
    </div>
    </template>

    {# Add-category modal — fired from any group header "+" icon. #}
    <template x-if="newCatOpen">
    <div class="modal-backdrop" @click.self="newCatOpen = false" @keydown.escape.window="newCatOpen = false">
      <div class="modal modal--sm" role="dialog" aria-modal="true" aria-labelledby="bd-cat-title">
        <h2 class="modal__title" id="bd-cat-title">
          New category in <span x-text="newCatGroupName || 'group'"></span>
        </h2>
        <form @submit.prevent="submitNewCategory()">
          <div class="field">
            <label class="field__label" for="bd-cat-name">Category name</label>
            <input class="input" id="bd-cat-name" type="text" x-model="newCatName" required autofocus
                   placeholder="e.g. Groceries, Rent, Coffee">
          </div>
          <div class="form-actions">
            <button class="btn btn--primary" type="submit">Add category</button>
            <button class="btn btn--ghost" type="button" @click="newCatOpen = false">Cancel</button>
          </div>
        </form>
      </div>
    </div>
    </template>

    {# Delete-group confirm — replaces window.confirm() so the dialog
       matches the rest of the app. #}
    <template x-if="deleteGroupId">
    <div class="modal-backdrop" @click.self="deleteGroupId = null" @keydown.escape.window="deleteGroupId = null">
      <div class="modal modal--sm" role="alertdialog" aria-modal="true"
           @keydown.enter.window.prevent="confirmDeleteGroup()" aria-labelledby="budget-dlg1-title">
        <h2 class="modal__title" id="budget-dlg1-title">Delete this group?</h2>
        <p style="color: var(--fg-muted); margin: 0 0 var(--space-md);">
          Categories inside <strong x-text="deleteGroupName"></strong> become ungrouped but are kept along with their activity and goals.
        </p>
        <div class="form-actions">
          <button class="btn btn--danger" type="button" @click="confirmDeleteGroup()" autofocus>Delete group</button>
          <button class="btn btn--ghost" type="button" @click="deleteGroupId = null">Cancel</button>
        </div>
      </div>
    </div>
    </template>

    {# Delete-category confirm — same chrome as the group variant. #}
    <template x-if="deleteCatId">
    <div class="modal-backdrop" @click.self="deleteCatId = null" @keydown.escape.window="deleteCatId = null">
      <div class="modal modal--sm" role="alertdialog" aria-modal="true"
           @keydown.enter.window.prevent="confirmDeleteCategory()" aria-labelledby="budget-dlg2-title">
        <h2 class="modal__title" id="budget-dlg2-title">Delete this category?</h2>
        <p style="color: var(--fg-muted); margin: 0 0 var(--space-md);">
          <strong x-text="deleteCatName"></strong>'s activity becomes uncategorized but stays in the register. Goals on this category are removed.
        </p>
        <div class="form-actions">
          <button class="btn btn--danger" type="button" @click="confirmDeleteCategory()" autofocus>Delete category</button>
          <button class="btn btn--ghost" type="button" @click="deleteCatId = null">Cancel</button>
        </div>
      </div>
    </div>
    </template>

    {# Rename modal — works for both groups and categories. #}
    <template x-if="renameOpen">
    <div class="modal-backdrop" @click.self="renameOpen = false" @keydown.escape.window="renameOpen = false">
      <div class="modal modal--sm" role="dialog" aria-modal="true" aria-labelledby="bd-rename-title">
        <h2 class="modal__title" id="bd-rename-title">
          Rename <span x-text="renameKind"></span>
        </h2>
        <form @submit.prevent="submitRename()">
          <div class="field">
            <label class="field__label" for="bd-rename-name">New name</label>
            <input class="input" id="bd-rename-name" type="text" x-model="renameName" required autofocus
                   @keydown.escape="renameOpen = false">
          </div>
          <div class="form-actions">
            <button class="btn btn--primary" type="submit">Save</button>
            <button class="btn btn--ghost" type="button" @click="renameOpen = false">Cancel</button>
          </div>
        </form>
      </div>
    </div>
    </template>

    {# Activity drill-down modal — opened by clicking any Outflow
       number on the budget grid. Lists every contributing transaction
       for the selected scope (category, group, or all) in the
       currently-active month, with a total at the bottom. #}
    <template x-if="activityOpen">
    <div class="modal-backdrop" @click.self="activityOpen = false" @keydown.escape.window="activityOpen = false">
      <div class="modal" role="dialog" aria-modal="true" aria-labelledby="bd-act-title" style="max-width: 760px;">
        <button class="modal__close" type="button" @click="activityOpen = false" aria-label="Close">&times;</button>
        <h2 class="modal__title" id="bd-act-title">
          <span x-text="activityScope.name"></span>
          <span style="color: var(--fg-muted); font-weight: 400; font-size: var(--fs-md);"
                x-text="' · ' + monthHeaderLabel(activityScope.month)"></span>
        </h2>
        <p style="color: var(--fg-muted); margin: 0 0 var(--space-sm);"
           x-text="activityTxns().length + ' transaction' + (activityTxns().length === 1 ? '' : 's')"></p>

        <div class="table-scroll">
          <table class="table">
            <thead>
              <tr>
                <th scope="col" style="white-space: nowrap;">Date</th>
                <th scope="col">Account</th>
                <th scope="col">Payee</th>
                <th scope="col" x-show="activityScope.kind !== 'category'">Category</th>
                <th scope="col">Memo</th>
                <th scope="col" class="num">Amount</th>
              </tr>
            </thead>
            <tbody>
              <template x-for="t in activityTxns()" :key="t.id + '-' + (t.splitKey || '')">
                <tr class="activity-row"
                    @click="openInRegister(t)"
                    :data-tip="'Open ' + ($store.budget.payeeName(t.payeeId) || 'this transaction') + ' in the register.'"
                    tabindex="0"
                    @keydown.enter="openInRegister(t)"
                    @keydown.space.prevent="openInRegister(t)"
                    role="button"
                    :aria-label="'Open ' + ($store.budget.payeeName(t.payeeId) || 'transaction') + ' from ' + t.date + ' in the register'">
                  <td style="white-space: nowrap;" x-text="t.date"></td>
                  <td x-text="$store.budget.findAccount(t.accountId)?.name || '—'"></td>
                  <td x-text="$store.budget.payeeName(t.payeeId) || '—'"></td>
                  <td x-show="activityScope.kind !== 'category'"
                      x-text="$store.budget.categoryName(t.categoryId) || 'Uncategorized'"
                      style="color: var(--fg-muted);"></td>
                  <td style="color: var(--fg-muted);" x-text="t.memo || ''"></td>
                  <td class="num" :class="t.amount < 0 ? 'amount--outflow' : 'amount--inflow'"
                      x-text="formatCents(t.amount)"></td>
                </tr>
              </template>
              <tr x-show="!activityTxns().length" x-cloak>
                <td :colspan="activityScope.kind !== 'category' ? 6 : 5"
                    style="color: var(--fg-muted); text-align: center; padding: var(--space-md);">
                  No transactions in this scope for the active month.
                </td>
              </tr>
            </tbody>
            <tfoot x-show="activityTxns().length" x-cloak>
              <tr style="border-top: 2px solid var(--border);">
                <td :colspan="activityScope.kind !== 'category' ? 5 : 4"
                    style="font-weight: 600;">Total</td>
                <td class="num" style="font-weight: 700;"
                    :class="activityTotal() < 0 ? 'amount--outflow' : 'amount--inflow'"
                    x-text="formatCents(activityTotal())"></td>
              </tr>
            </tfoot>
          </table>
        </div>

        <div class="form-actions" style="margin-top: var(--space-md);">
          <a class="btn btn--secondary btn--sm"
             x-show="activityScope.kind === 'category'"
             :href="'/app/register/?category=' + activityScope.id"
             data-tip="Open these transactions in the full register.">Open in register</a>
          <button class="btn btn--ghost btn--sm" type="button" @click="activityOpen = false">Close</button>
        </div>
      </div>
    </div>
    </template>

    

</div>
