---
layout: layouts/app.njk
title: "Dashboard"
description: "Your active budget at a glance — ready to assign, net worth, this month's flow, upcoming bills, goal progress, and alerts."
permalink: /app/
eleventyExcludeFromCollections: true
---
{% from "partials/overflow-menu.njk" import overflow %}
{% import "partials/dashboard-widgets.njk" as W %}
{% import "partials/dashboard-views.njk" as V2 %}
<div class="app-page" x-data="dashboardView()" x-init="init()">
  <header class="app-page__header">
    <div>
      <h1 class="app-page__title">Dashboard</h1>
      <p class="app-page__lead">
        <span x-show="$store.budget.profile" x-text="$store.budget.profile?.name"></span>
        <span x-show="!$store.budget.profile" x-cloak>No active profile.</span>
      </p>
    </div>
  </header>

  {# ---- Empty state ---- #}
  <div class="empty-state" x-show="!$store.budget.profile" x-cloak>
    <h2 class="empty-state__title">Create your first profile</h2>
    <p class="empty-state__body">
      A profile is a complete budget — its own accounts, categories, transactions, and goals. Create as many as you need and switch between them whenever you like. Profiles are stored only in this browser.
    </p>
    <div class="empty-state__actions">
      <a class="btn btn--primary" href="/app/profiles/">Create a profile</a>
      <a class="btn btn--secondary" href="/app/import/">Import a JSON export</a>
    </div>
  </div>

  <div x-show="$store.budget.profile" x-cloak>

    {# Inline quick-add removed — the persistent FAB
       (src/_includes/partials/fab-quick-add.njk, mounted in
       src/_includes/layouts/app.njk) is the canonical add path
       on every app page including the dashboard. #}


    {# ---- Dashboard toolbar: which dashboard, and editing it ---- #}
    <div class="dash-toolbar" x-show="$store.budget.profile" x-cloak>
      <div class="dash-toolbar__left">
        <label class="visually-hidden" for="dash-picker">Dashboard</label>
        <select id="dash-picker" class="input dash-toolbar__picker"
                :value="activeId()"
                @change="$store.budget.setActiveDashboard($event.target.value)">
          <template x-for="d in $store.budget.dashboardList()" :key="d.id">
            <option :value="d.id" :selected="d.id === activeId()" x-text="d.name"></option>
          </template>
        </select>
        <span class="dash-toolbar__count"
              x-text="widgets().length + (widgets().length === 1 ? ' widget' : ' widgets')"></span>
      </div>

      <div class="dash-toolbar__right">
        {# Edit mode is an explicit toggle rather than always-on drag handles.
           A dashboard is read far more often than it is rearranged, and grips
           on every card turn a calm screen into a construction site -- worse,
           they make an accidental drag a normal outcome of trying to scroll
           on a touch screen. #}
        <button type="button" class="btn"
                :class="editing ? 'btn--primary' : ''"
                @click="toggleEdit()"
                :aria-pressed="editing.toString()"
                :data-tip="editing ? 'Finish editing this dashboard.' : 'Rearrange, resize, add or remove widgets.'">
          <span x-text="editing ? 'Done' : 'Edit'"></span>
        </button>

        <button type="button" class="btn" x-show="editing" x-cloak
                @click="pickerOpen = true"
                data-tip="Add a widget to this dashboard.">Add widget</button>

        {% call overflow(label="Dashboard actions") %}
          <li role="none">
            <button type="button" role="menuitem" class="overflow-menu__item"
                    @click="open = false; newDashboard()">New dashboard…</button>
          </li>
          <li role="none">
            <button type="button" role="menuitem" class="overflow-menu__item"
                    @click="open = false; renameDashboard()">Rename…</button>
          </li>
          <li role="none">
            <button type="button" role="menuitem" class="overflow-menu__item"
                    @click="open = false; $store.budget.duplicateDashboard(activeId())">Duplicate</button>
          </li>
          <li role="none" class="overflow-menu__sep" aria-hidden="true"></li>
          <li role="none">
            <button type="button" role="menuitem" class="overflow-menu__item"
                    @click="open = false; exportPdf()">Export as PDF…</button>
          </li>
          <li role="none">
            <button type="button" role="menuitem" class="overflow-menu__item"
                    @click="open = false; exportLayout()"
                    data-tip="Saves the layout only — no amounts leave your device.">Export layout…</button>
          </li>
          <li role="none">
            <button type="button" role="menuitem" class="overflow-menu__item"
                    @click="open = false; $refs.importFile.click()">Import layout…</button>
          </li>
          <li role="none" class="overflow-menu__sep" aria-hidden="true"></li>
          <li role="none">
            <button type="button" role="menuitem" class="overflow-menu__item"
                    @click="open = false; resetLayout()">Reset to default layout</button>
          </li>
          <li role="none">
            <button type="button" role="menuitem" class="overflow-menu__item overflow-menu__item--danger"
                    @click="open = false; deleteDashboard()">Delete dashboard</button>
          </li>
        {% endcall %}
        {# `hidden`, not .visually-hidden. This input is a mechanism, not a
           control: it is never focused, tabbed to or clicked by a person --
           the menu item calls .click() on it, which works fine on a
           display:none file input in every current browser. .visually-hidden
           clips to 1x1 instead of removing it, so it rendered as a real 1x1
           target and showed up in the touch census as a control nobody can
           hit. #}
        <input type="file" accept="application/json,.json" x-ref="importFile" hidden
               @change="importLayout($event)">
      </div>
    </div>

    {# ---- The grid ----
       Widgets come from the active dashboard's ordered list. The :key is the
       widget id so Alpine MOVES existing nodes on reorder instead of
       recreating them -- which is what keeps the Chart.js canvases alive
       through a rearrange. Rebuilding them would leak a chart per move. #}
    <div class="dash-grid"
         :class="editing ? 'is-editing' : ''"
         x-ref="grid"
         x-show="$store.budget.profile" x-cloak>
      <template x-for="(widget, i) in widgets()" :key="widget.id">
        <section class="dash-widget"
                 :data-widget-id="widget.id"
                 :data-widget-kind="$store.budget.widgetKind(widget)"
                 :style="widgetStyle(widget)"
                 :aria-label="titleOf(widget)">

          {# Editing chrome. Present only in edit mode, so a widget in read
             mode is exactly the card it always was. #}
          <div class="dash-widget__chrome" x-show="editing" x-cloak>
            <button type="button"
                    class="dash-widget__grip"
                    data-widget-grip
                    :aria-label="'Move ' + titleOf(widget) + '. Press space to pick up, then arrow keys to move, shift and arrows to resize.'"
                    data-tip="Drag to move — or press space and use the arrow keys.">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <circle cx="9" cy="6" r="1.6"/><circle cx="15" cy="6" r="1.6"/>
                <circle cx="9" cy="12" r="1.6"/><circle cx="15" cy="12" r="1.6"/>
                <circle cx="9" cy="18" r="1.6"/><circle cx="15" cy="18" r="1.6"/>
              </svg>
            </button>
            <span class="dash-widget__name" x-text="titleOf(widget)"></span>
            <span class="dash-widget__size" x-text="widget.w + '\u00d7' + widget.h"></span>
            <button type="button" class="dash-widget__remove"
                    @click="$store.budget.removeWidget(activeId(), widget.id)"
                    :aria-label="'Remove ' + titleOf(widget)"
                    data-tip="Remove this widget. Undo brings it back.">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </button>
          </div>

          <template x-if="widget.view === 'panel:hero'">
<div class="dash-widget__body">{{ W.w_hero() }}</div></template>
          <template x-if="widget.view === 'panel:kpis'">
<div class="dash-widget__body">{{ W.w_kpis() }}</div></template>
          <template x-if="widget.view === 'panel:insights'">
<div class="dash-widget__body">{{ W.w_insights() }}</div></template>
          <template x-if="widget.view === 'panel:accounts'">
<div class="dash-widget__body">{{ W.w_accounts() }}</div></template>
          <template x-if="widget.view === 'panel:cashflow'">
<div class="dash-widget__body">{{ W.w_cashflow() }}</div></template>
          <template x-if="widget.view === 'panel:income-expense'">
<div class="dash-widget__body">{{ W.w_income_expense() }}</div></template>
          <template x-if="widget.view === 'panel:top-categories'">
<div class="dash-widget__body">{{ W.w_top_categories() }}</div></template>
          <template x-if="widget.view === 'panel:cashflow-30'">
<div class="dash-widget__body">{{ W.w_cashflow_30() }}</div></template>
          <template x-if="widget.view === 'panel:upcoming-bills'">
<div class="dash-widget__body">{{ W.w_upcoming_bills() }}</div></template>
          <template x-if="widget.view === 'panel:goals'">
<div class="dash-widget__body">{{ W.w_goals() }}</div></template>
          <template x-if="widget.view === 'panel:recent'">
<div class="dash-widget__body">{{ W.w_recent() }}</div></template>
          <template x-if="widget.view === 'panel:alerts'">
<div class="dash-widget__body">{{ W.w_alerts() }}</div></template>
          <template x-if="widget.view === 'panel:quick-actions'">
<div class="dash-widget__body">{{ W.w_quick_actions() }}</div></template>

          {# The generic views. One block each, driven by the source's declared
             fields, so every report source is renderable four ways without a
             line of per-source markup. A chart host carries no id -- a chart
             widget can be placed twice and duplicate ids on rendered content
             trip axe's zero-tolerance duplicate-id-active. #}
          <template x-if="$store.budget.widgetKind(widget) === 'table'">
            <div class="dash-widget__body">{{ V2.v_table() }}</div>
          </template>
          <template x-if="$store.budget.widgetKind(widget) === 'list'">
            <div class="dash-widget__body">{{ V2.v_list() }}</div>
          </template>
          <template x-if="$store.budget.widgetKind(widget) === 'stat'">
            <div class="dash-widget__body">{{ V2.v_stat() }}</div>
          </template>
          <template x-if="$store.budget.widgetKind(widget) === 'chart' && widget.source.indexOf('report:') === 0">
            <div class="dash-widget__body">
              <div class="chart dashboard__chart"
                   data-chart-host
                   :data-widget-id="widget.id"
                   :data-chart-module="$store.budget.widgetModule(widget)"></div>
            </div>
          </template>

          {# Resize handle. Pointer only -- the keyboard equivalent is
             shift+arrows on the grip, which is discoverable from the grip's
             own label rather than needing a second focusable control. #}
          <button type="button" class="dash-widget__resize" data-widget-resize
                  x-show="editing" x-cloak tabindex="-1" aria-hidden="true"></button>
        </section>
      </template>
    </div>

    {# ---- Widget picker ---- #}
    <div class="modal-backdrop" x-show="pickerOpen" x-cloak
         @click.self="pickerOpen = false"
         @keydown.escape.window="pickerOpen = false">
      <div class="modal modal--wide" role="dialog" aria-modal="true" aria-labelledby="dash-picker-title">
        <div class="modal__head">
          <h2 id="dash-picker-title" class="modal__title">Add a widget</h2>
          <button type="button" class="modal__close" @click="pickerOpen = false" aria-label="Close">&times;</button>
        </div>
        <div class="modal__body">
          <ul class="widget-picker">
            <template x-for="w in $store.budget.availableWidgets(activeId())" :key="w.id">
              <li>
                <button type="button" class="widget-picker__item"
                        :disabled="w.disabled"
                        @click="$store.budget.addWidget(activeId(), w.id); pickerOpen = false">
                  <span class="widget-picker__title" x-text="w.title"></span>
                  <span class="widget-picker__desc" x-text="w.description"></span>
                  <span class="widget-picker__on" x-show="w.disabled" x-cloak>Already on this dashboard</span>
                </button>
              </li>
            </template>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function dashboardView() {
  return {
    /* ---- Dashboard editing ----
       `editing` is deliberately NOT persisted. Edit mode is a thing you are
       doing right now, not a property of the dashboard; coming back to the
       app a day later and finding every card wearing drag handles reads as
       breakage. */
    editing: false,
    pickerOpen: false,

    /* `void ... _listVersion` is this codebase's reactivity handshake, not a
       stray line. The store does not rely on deep proxying for the profile's
       collections -- proxying thousands of transactions is what it is
       avoiding -- so every mutator calls _bumpLists() and every reader that
       must re-run touches the counter. Without it the dashboard rendered
       once and then ignored every move, resize, add and remove: the store was
       correct and the screen was a photograph of the first paint. */
    activeId() {
      void this.$store.budget._listVersion;
      var d = this.$store.budget.activeDashboard();
      return d ? d.id : null;
    },
    widgets() {
      void this.$store.budget._listVersion;
      var d = this.$store.budget.activeDashboard();
      return d ? d.widgets.slice() : [];
    },
    /* ---- generic view helpers ----
       Formatting is driven by the FIELD's declared flags, never guessed from
       the value: an amount is money because the source says the field is
       money, not because it happens to be large. */
    fmtField(value, field) {
      if (value == null || value === "") return "";
      if (field && field.money) return this.fmt(value);
      if (field && field.percent) {
        var n = Number(value);
        return isFinite(n) ? Math.round(n * 100) + "%" : "";
      }
      return String(value);
    },

    statText(stat) {
      if (!stat) return "";
      if (stat.money) return this.fmt(stat.value);
      if (stat.percent) return Math.round(stat.value * 100) + "%";
      return String(stat.value);
    },

    /* A widget only ever shows as many rows as its height can hold. Without
       this a 3-row table widget renders forty rows and simply grows, which
       makes the stored height meaningless and the grid ragged. */
    rowLimit(widget) {
      return Math.max(3, (widget.h || 4) * 2);
    },

    rowLabel(widget, row) {
      var fields = this.$store.budget.widgetFields(widget);
      for (var i = 0; i < fields.length; i++) if (!fields[i].numeric) return String(row[fields[i].key] || "");
      return "";
    },

    rowValue(widget, row) {
      var fields = this.$store.budget.widgetFields(widget);
      for (var i = 0; i < fields.length; i++) if (fields[i].numeric) return this.fmtField(row[fields[i].key], fields[i]);
      return "";
    },

    titleOf(widget) {
      return this.$store.budget.widgetTitle(widget);
    },

    /* Width in columns, height in rows. Only the span is inline -- the track
       sizes live in CSS so the grid stays responsive and the phone breakpoint
       can collapse everything to one column without fighting inline styles. */
    widgetStyle(widget) {
      return "grid-column: span " + widget.w + "; grid-row: span " + widget.h + ";";
    },

    toggleEdit() {
      this.editing = !this.editing;
      if (this.editing) this.$nextTick(this._bindGrid.bind(this));
    },

    _bindGrid() {
      var self = this;
      var grid = this.$refs.grid;
      if (!grid || !window.PBDashGrid) return;
      window.PBDashGrid.attach(grid, {
        move: function (id, to) { self.$store.budget.moveWidget(self.activeId(), id, to); },
        resize: function (id, w, h) { self.$store.budget.resizeWidget(self.activeId(), id, w, h); },
        sizeOf: function (id) {
          var w = self.widgets().find(function (x) { return x.id === id; });
          return w ? { w: w.w, h: w.h } : { w: 6, h: 4 };
        },
        titleOf: function (id) {
          var w = self.widgets().find(function (x) { return x.id === id; });
          return w ? self.titleOf(w) : "Widget";
        },
        /* Resize previews on the element so the drag feels direct, then
           commits once on release -- committing per pointermove would push a
           hundred undo entries for one gesture. */
        previewSize: function (el, w, h) {
          el.style.gridColumn = "span " + Math.max(1, Math.min(12, w));
          el.style.gridRow = "span " + Math.max(1, Math.min(24, h));
        },
        readPreview: function (el) {
          var col = /span (\d+)/.exec(el.style.gridColumn || "");
          var row = /span (\d+)/.exec(el.style.gridRow || "");
          return { w: col ? +col[1] : 6, h: row ? +row[1] : 4 };
        },
      });
    },

    /* ---- dashboard-level actions ---- */
    newDashboard() {
      var name = window.prompt("Name this dashboard", "New dashboard");
      if (name == null) return;
      this.$store.budget.createDashboard(name.trim() || "New dashboard", []);
      this.editing = true;
      this.$nextTick(this._bindGrid.bind(this));
    },
    renameDashboard() {
      var d = this.$store.budget.activeDashboard();
      if (!d) return;
      var name = window.prompt("Rename dashboard", d.name);
      if (name == null) return;
      this.$store.budget.renameDashboard(d.id, name);
    },
    deleteDashboard() {
      var d = this.$store.budget.activeDashboard();
      if (!d) return;
      if (!window.confirm('Delete "' + d.name + '"? Undo will bring it back.')) return;
      this.$store.budget.deleteDashboard(d.id);
    },
    resetLayout() {
      if (!window.confirm("Reset this dashboard to the default layout?")) return;
      this.$store.budget.resetDashboard(this.activeId());
    },

    /* ---- portability ----
       Layout export carries no figures (see slices/dashboards.js). The PDF
       does, which is why they are separate menu items with different words. */
    exportLayout() {
      var def = this.$store.budget.exportDefinition(this.activeId());
      if (!def) return;
      var blob = new Blob([JSON.stringify(def, null, 2)], { type: "application/json" });
      var url = URL.createObjectURL(blob);
      var a = document.createElement("a");
      a.href = url;
      a.download = (def.name || "dashboard").replace(/[^a-z0-9]+/gi, "-").toLowerCase() + "-layout.json";
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
      this.$store.budget.pushToast("Layout exported — no amounts included");
    },
    importLayout(e) {
      var file = e.target.files && e.target.files[0];
      if (!file) return;
      var self = this;
      var reader = new FileReader();
      reader.onload = function () { self.$store.budget.importDefinition(String(reader.result)); };
      reader.readAsText(file);
      e.target.value = "";
    },
    exportPdf() {
      if (!window.PBDashboardPdf) { this.$store.budget.pushToast("PDF export isn't loaded yet — try again in a moment"); return; }
      var d = this.$store.budget.activeDashboard();
      window.PBDashboardPdf.export(this.$refs.grid, d ? d.name : "Dashboard");
    },

    chartIE: null,
    chartProj: null,
    /* Inline quick-add state. Pre-populated with today's date + the
       first open account once the profile loads via the quickAccounts
       getter. Auto-rules fire on submit (categorize / normalize-payee)
       so manual entries are normalized just like imports. */
    quickForm: { date: "", payeeName: "", amount: "", accountId: "", categoryId: "", type: "outflow" },

    /* ---- Memoization layer ----
       The dashboard surfaces a dozen getters that each walk the full
       transactions list (1,000+ rows at sample scale). Alpine
       re-evaluates them on every reactivity tick, so without caching
       a single mutation re-walks the list dozens of times — visibly
       slow on mobile. _memo() returns a cached value keyed on
       _listVersion + currentMonth + a per-call salt; cache is
       invalidated automatically on any store mutation that bumps
       lists or on a month switch. */
    _memoCache: Object.create(null),
    _memoKey: null,
    _memo(key, compute) {
      var s = this.$store.budget;
      var cacheKey = (s._listVersion || 0) + ":" + (s.currentMonth || "") + ":" + (s.profile ? s.profile.id : "");
      if (this._memoKey !== cacheKey) {
        this._memoCache = Object.create(null);
        this._memoKey = cacheKey;
      }
      if (key in this._memoCache) return this._memoCache[key];
      var v = compute();
      this._memoCache[key] = v;
      return v;
    },

    init() {
      var self = this;
      /* Seed the inline quick-add form. Account is filled in lazily
         via the quickAccounts() getter once the profile loads. */
      this.quickForm.date = new Date().toISOString().slice(0, 10);
      /* ---- Charts ----
         The two sparklines live inside widgets now, so their host elements
         are not guaranteed to exist when init() runs, and they can appear or
         vanish at any time as widgets are added, removed or reordered.

         The previous one-shot mount assumed a static page and failed
         silently in the most confusing way possible: mountChart() returns a
         no-op { redraw, dispose } stub when its selector matches nothing, so
         there was no error anywhere -- just two permanently empty chart
         boxes.

         _syncCharts() is therefore idempotent and re-runs after every
         render. It keys on the host ELEMENT, not on whether a chart object
         exists: Alpine reuses keyed nodes on reorder but replaces them when
         a widget is removed and re-added, and a chart still bound to a
         detached element is exactly the leak this project has chased before. */
      /* Addressed by data attribute, never by id. A chart widget can be
         placed more than once, and duplicate ids on rendered content trip
         axe's duplicate-id-active, which is a ZERO-tolerance rule in the
         ratchet rather than a budgeted one. */
      var CHART_SPECS = [
        { sel: '[data-chart-view="income-expense"]', key: "chartIE",
          render: function () { return window.pbDashRenderIE; },
          data: function (store) { return store.reportIncomeVsExpense(null, 6); } },
        { sel: '[data-chart-view="projection"]', key: "chartProj",
          render: function () { return window.pbDashRenderProj; },
          data: function (store) { return store.reportProjection(1); } },
      ];
      this._chartHosts = {};

      this._syncCharts = function () {
        if (!window.pbMountChart) return;
        var store = Alpine.store("budget");
        for (var i = 0; i < CHART_SPECS.length; i++) {
          var spec = CHART_SPECS[i];
          var host = document.querySelector(spec.sel);
          var mounted = self[spec.key];
          if (!host) {
            /* Widget removed — drop the chart with it. */
            if (mounted) { try { mounted.dispose(); } catch (_e) {} self[spec.key] = null; self._chartHosts[spec.key] = null; }
            continue;
          }
          if (mounted && self._chartHosts[spec.key] === host) continue; /* still good */
          if (mounted) { try { mounted.dispose(); } catch (_e2) {} }
          var renderFn = spec.render();
          if (!renderFn) continue; /* chart module still loading */
          self[spec.key] = window.pbMountChart(spec.sel, renderFn, (function (sp) {
            return function () { return sp.data(store); };
          })(spec));
          self._chartHosts[spec.key] = host;
        }
      };

      /* Wait for the store and the chart module, then keep charts in step
         with the layout for the rest of the session. */
      var tries = 0;
      var poll = function () {
        var ready = window.Alpine && window.Alpine.store && window.Alpine.store("budget") && window.pbMountChart && window.pbDashRenderIE && window.pbDashRenderProj;
        if (!ready) { if (++tries < 600) setTimeout(poll, 50); return; }
        var store = Alpine.store("budget");
        Alpine.effect(function () {
          /* Re-runs on any store mutation, which covers both "the data
             changed, redraw" and "the layout changed, (re)mount". */
          store.profile; store.currentMonth; store._listVersion;
          Alpine.nextTick(function () {
            self._syncCharts();
            if (self.chartIE) self.chartIE.redraw();
            if (self.chartProj) self.chartProj.redraw();
            /* Authored report widgets. Separate from _syncCharts, which owns
               the two hardcoded panel sparklines; this one is driven entirely
               by what is on the board. */
            if (window.PBDashCharts && self.$refs.grid) {
              window.PBDashCharts.sync(self.$refs.grid, {
                dataFor: function (id) {
                  var w = self.widgets().find(function (x) { return x.id === id; });
                  return w ? self.$store.budget.widgetData(w) : null;
                },
                needsFor: function (id) {
                  var w = self.widgets().find(function (x) { return x.id === id; });
                  return w ? self.$store.budget.widgetNeeds(w) : [];
                },
              });
            }
          });
        });
      };
      poll();
    },

    /* ---- Quick-add ---- */
    quickHasAccounts() {
      void this.$store.budget._listVersion;
      var p = this.$store.budget.profile;
      return !!(p && (p.accounts || []).some(function (a) { return !a.closedAt; }));
    },
    quickAccounts() {
      void this.$store.budget._listVersion;
      var p = this.$store.budget.profile;
      if (!p) return [];
      var open = (p.accounts || [])
        .filter(function (a) { return !a.closedAt; })
        .sort(function (a, b) { return a.name.localeCompare(b.name); });
      /* Seed accountId on the form once accounts exist. */
      if (open.length && !this.quickForm.accountId) {
        this.quickForm.accountId = open[0].id;
      }
      return open;
    },
    _parseQuickAmount(s) {
      if (s == null || s === "") return 0;
      if (window.PBCalc) {
        var v = window.PBCalc.parseAmountCents(s);
        if (isFinite(v)) return v;
      }
      var clean = String(s).replace(/[$,\s]/g, "").trim();
      if (/^\(.*\)$/.test(clean)) clean = "-" + clean.slice(1, -1);
      var n = Number(clean);
      return isFinite(n) ? Math.round(n * 100) : 0;
    },
    /* Filter the category dropdown to match the toggle: outflow shows
       expense-group categories, inflow shows income-group categories.
       Same rule as the register page so the UX is consistent. */
    quickCategoriesForType(type) {
      var s = this.$store.budget;
      return (s.categoriesFlat() || []).filter(function (c) {
        if (s.isPaymentCategory(c.id)) return false;
        var isIncome = s.isIncomeCategory(c.id);
        if (type === "inflow") return isIncome;
        return !isIncome;
      });
    },
    quickAddSubmit() {
      var f = this.quickForm;
      if (!f.accountId) return;
      var rawAmount = this._parseQuickAmount(f.amount);
      if (!rawAmount) { this.$store.budget.pushToast("Amount is required.", "warn"); return; }
      /* Toggle owns the sign. Users type a positive number on the
         mobile keypad; we apply outflow/inflow direction here. */
      var amount = Math.abs(rawAmount) * (f.type === "inflow" ? 1 : -1);
      this.$store.budget.addTransaction({
        accountId: f.accountId,
        date: f.date || new Date().toISOString().slice(0, 10),
        payeeName: f.payeeName,
        categoryId: f.categoryId || null,
        amount: amount,
        memo: "",
        cleared: false,
      });
      this.$store.budget.pushToast("Added transaction.", "ok");
      /* Reset just the per-row inputs, preserve account + date + type
         so entering a batch is fast. */
      this.quickForm.payeeName = "";
      this.quickForm.amount = "";
      this.quickForm.categoryId = "";
      var self = this;
      this.$nextTick(function () {
        var el = document.getElementById("qa-payee");
        if (el) el.focus();
      });
    },

    /* ---- Hero band ---- */
    heroEyebrow() {
      var now = new Date();
      var hour = now.getHours();
      var greeting = hour < 12 ? "Good morning" : (hour < 18 ? "Good afternoon" : "Good evening");
      var profile = this.$store.budget.profile;
      return greeting + (profile && profile.name ? " — " + profile.name : "");
    },
    heroTitle() {
      var d = new Date();
      return d.toLocaleDateString("en-US", { weekday: "long", month: "long", day: "numeric" });
    },
    /* One-line, plain-English summary of the most relevant signal
       for this month. Priority order: overdrawn account > overspent
       categories > unassigned RTA > on-track positive net. */
    heroInsight() {
      var s = this.$store.budget;
      if (!s.profile) return "";
      var rta = s.readyToAssign();
      var os = this.overspent();
      var net = this.thisMonthNet();
      if (os.count > 0) {
        return os.count + " categor" + (os.count === 1 ? "y is" : "ies are") + " overspent by " + this.fmt(os.totalDeficit) + " this month.";
      }
      if (rta > 10000) {
        return this.fmt(rta) + " is unassigned for " + s.currentMonth + " — assign every dollar a job.";
      }
      if (net > 0) {
        return "Net positive this month: " + this.fmt(net) + " saved so far.";
      }
      if (net < 0) {
        return "Spending exceeds income this month by " + this.fmt(Math.abs(net)) + ".";
      }
      return "Every dollar is assigned. Keep going.";
    },
    /* Compare current netWorth to netWorth from ~6 months back via the
       netWorthByMonth report. Returns { from, to, pct }. */
    netWorthDelta() {
      var self = this;
      return this._memo("netWorthDelta", function () {
        var s = self.$store.budget;
        var to = s.netWorth();
        var series = s.reportNetWorth(null, 7) || [];
        if (!series.length) return { from: to, to: to, pct: 0 };
        var fromRow = series[0];
        var from = fromRow && typeof fromRow.netWorth === "number" ? fromRow.netWorth : (fromRow && fromRow.total) || to;
        var pct = from !== 0 ? ((to - from) / Math.abs(from)) * 100 : 0;
        return { from: from, to: to, pct: pct };
      });
    },

    /* ---- Cash flow this month (mini sankey) ---- */
    /* Aggregates current-month transactions into top-5 income
       sources (categorized inflows) and top-5 expense categories,
       plus totals. Each row carries a `pct` (0..100) relative to
       the column's biggest value so the bars scale proportionally
       without needing JS to set widths beyond a single CSS var. */
    flowThisMonth() {
      var self = this;
      return this._memo("flowThisMonth", function () {
        var s = self.$store.budget;
        if (!s.profile) return { sources: [], sinks: [], income: 0, expense: 0, net: 0, total: 0 };
        var month = s.currentMonth;
        var inMap = {};
        var outMap = {};
        var income = 0, expense = 0;
        (s.profile.transactions || []).forEach(function (t) {
          if (!t || !t.date || t.date.slice(0, 7) !== month) return;
          if (t.transferTxnId) return;
          var label = s.categoryName(t.categoryId) || (t.amount >= 0 ? "Uncategorized income" : "Uncategorized");
          if (t.amount > 0) {
            inMap[label] = (inMap[label] || 0) + t.amount;
            income += t.amount;
          } else if (t.amount < 0) {
            var v = -t.amount;
            outMap[label] = (outMap[label] || 0) + v;
            expense += v;
          }
        });
        function topN(map) {
          var arr = Object.keys(map).map(function (k) { return { name: k, value: map[k] }; });
          arr.sort(function (a, b) { return b.value - a.value; });
          arr = arr.slice(0, 5);
          var max = arr.length ? arr[0].value : 1;
          arr.forEach(function (r) { r.pct = Math.round((r.value / max) * 100); });
          return arr;
        }
        return {
          sources: topN(inMap),
          sinks:   topN(outMap),
          income: income,
          expense: expense,
          net: income - expense,
          total: income + expense,
        };
      });
    },

    /* ---- Smart insights ---- */
    /* Walks the recent activity + budget to surface 0–6 plain-
       English signals. Each insight returns
         { id, severity, icon, title, detail, href?, cta? }
       severity = ok | info | warn | danger drives the color rail. */
    insights() {
      var self = this;
      return this._memo("insights", function () { return self._computeInsights(); });
    },
    _computeInsights() {
      var s = this.$store.budget;
      if (!s.profile) return [];
      var out = [];
      var self = this;

      /* (1) Category whose spending is up >25% vs the prior month
         and is among the top-5 expenses this month. */
      var top = this.topCategoriesRows();
      if (top.length) {
        var thisMonth = s.currentMonth;
        var parts = thisMonth.split("-").map(Number);
        var prevDate = new Date(parts[0], (parts[1] || 1) - 2, 1);
        var prevMonth = prevDate.getFullYear() + "-" + String(prevDate.getMonth() + 1).padStart(2, "0");
        var prevSpending = s.reportSpending(prevMonth, prevMonth) || [];
        var prevByCat = {};
        prevSpending.forEach(function (r) { prevByCat[r.categoryId] = r.value; });
        var biggestMover = null;
        top.forEach(function (r) {
          var prev = prevByCat[r.categoryId] || 0;
          if (prev <= 0) return;
          var pctChange = ((r.value - prev) / prev) * 100;
          if (pctChange > 25 && (!biggestMover || pctChange > biggestMover.pctChange)) {
            biggestMover = { row: r, prev: prev, pctChange: pctChange };
          }
        });
        if (biggestMover) {
          out.push({
            id: "spike-" + biggestMover.row.categoryId,
            severity: "warn",
            icon: "↑",
            title: biggestMover.row.category + " is up " + Math.round(biggestMover.pctChange) + "% vs last month",
            detail: self.fmt(biggestMover.row.value) + " this month, " + self.fmt(biggestMover.prev) + " last.",
            href: "/app/register/?q=" + encodeURIComponent(biggestMover.row.category),
            cta: "View",
          });
        }
      }

      /* (2) Trailing 3-month savings rate trend. */
      var sr = s.reportSavingsRate(null, 3) || [];
      if (sr.length >= 3) {
        var sumInc = 0, sumExp = 0;
        sr.forEach(function (m) { sumInc += m.income || 0; sumExp += m.expense || 0; });
        if (sumInc > 0) {
          var rate = ((sumInc - sumExp) / sumInc) * 100;
          if (rate >= 20) {
            out.push({
              id: "savings-strong",
              severity: "ok",
              icon: "★",
              title: "Saving " + Math.round(rate) + "% of income on average",
              detail: "3-month trailing rate. Keep it going.",
              href: "/app/reports/savings-rate/",
              cta: "Trend",
            });
          } else if (rate < 0) {
            out.push({
              id: "savings-negative",
              severity: "danger",
              icon: "↓",
              title: "Spending exceeds income on a 3-month rolling basis",
              detail: "Trailing savings rate is " + Math.round(rate) + "%. Review the budget.",
              href: "/app/reports/savings-rate/",
              cta: "Open",
            });
          }
        }
      }

      /* (3) Subscriptions detector. */
      var subs = s.reportSubscriptions(6) || [];
      if (subs.length) {
        var monthly = subs.reduce(function (acc, sub) {
          return acc + (sub.monthlyEstimate || 0);
        }, 0);
        if (monthly > 0) {
          out.push({
            id: "subs-summary",
            severity: "info",
            icon: "↻",
            title: subs.length + " recurring charge" + (subs.length === 1 ? "" : "s") + " detected",
            detail: self.fmt(monthly) + " / month estimated — review for anything you don't need.",
            href: "/app/reports/subscriptions/",
            cta: "Audit",
          });
        }
      }

      /* (4) Largest single expense in the current month. */
      var monthTxns = (s.profile.transactions || []).filter(function (t) {
        return t.date && t.date.slice(0, 7) === s.currentMonth && t.amount < 0 && !t.transferTxnId;
      });
      if (monthTxns.length) {
        var biggest = monthTxns.reduce(function (max, t) {
          return Math.abs(t.amount) > Math.abs(max.amount) ? t : max;
        }, monthTxns[0]);
        if (Math.abs(biggest.amount) >= 20000) {
          out.push({
            id: "big-" + biggest.id,
            severity: "info",
            icon: "$",
            title: "Largest expense this month: " + (s.payeeName(biggest.payeeId) || "Unknown"),
            detail: self.fmt(Math.abs(biggest.amount)) + " on " + self.shortDate(biggest.date) + " (" + (s.categoryName(biggest.categoryId) || "Uncategorized") + ").",
            href: "/app/register/?focus=" + biggest.id,
            cta: "Open",
          });
        }
      }

      return out.slice(0, 6);
    },

    /* ---- Account balances grid ---- */
    allAccountsForGrid() {
      var self = this;
      return this._memo("allAccountsForGrid", function () {
        var p = self.$store.budget.profile;
        if (!p || !p.accounts) return [];
        var s = self.$store.budget;
        var groupNameById = {};
        (p.accountGroups || []).forEach(function (g) { groupNameById[g.id] = g.name; });
        return p.accounts
          .filter(function (a) { return !a.closedAt; })
          .map(function (a) {
            return {
              id: a.id,
              name: a.name,
              groupName: groupNameById[a.groupId] || "",
              excludeFromNetWorth: !!a.excludeFromNetWorth,
              balance: s.accountBalance(a.id),
            };
          })
          .sort(function (a, b) {
            if (a.groupName !== b.groupName) return a.groupName.localeCompare(b.groupName);
            return a.name.localeCompare(b.name);
          });
      });
    },

    /* ---- Formatting helpers ---- */
    fmt(c) {
      return ((c || 0) / 100).toLocaleString("en-US", {
        style: "currency", currency: "USD", maximumFractionDigits: 0,
      });
    },
    /* Compact form for sub-labels — "$1.2k" / "$4.5M". */
    /* Magnitude-aware compact format. Drop the decimal once the
       leading value is >=100 so big numbers ($754k, $1.2M) don't
       imply false precision; keep 1 decimal for small/medium
       magnitudes ($1.2k, $57.5k). Math.round = half-up standard
       rounding. */
    fmtCompact(c) {
      var n = (c || 0) / 100;
      var sign = n < 0 ? "-" : "";
      var abs = Math.abs(n);
      if (abs >= 1000000) {
        var m = abs / 1000000;
        return sign + "$" + (m >= 100 ? Math.round(m) : (Math.round(m * 10) / 10)) + "M";
      }
      if (abs >= 1000) {
        var k = abs / 1000;
        return sign + "$" + (k >= 100 ? Math.round(k) : (Math.round(k * 10) / 10)) + "k";
      }
      return sign + "$" + Math.round(abs);
    },
    shortDate(iso) {
      if (!iso) return "";
      var parts = iso.slice(0, 10).split("-");
      var months = ["JAN","FEB","MAR","APR","MAY","JUN","JUL","AUG","SEP","OCT","NOV","DEC"];
      return months[Number(parts[1]) - 1] + " " + Number(parts[2]);
    },

    /* ---- This-month flow (1-month report) — memoized ---- */
    _thisMonthRow() {
      var self = this;
      return this._memo("_thisMonthRow", function () {
        var rows = self.$store.budget.reportIncomeVsExpense(null, 1) || [];
        return rows[0] || { income: 0, expense: 0, net: 0 };
      });
    },
    thisMonthIncome()  { return this._thisMonthRow().income; },
    thisMonthExpense() { return this._thisMonthRow().expense; },
    thisMonthNet()     { return this._thisMonthRow().net; },

    /* ---- Savings rate (3-month rolling) — memoized ---- */
    savingsRatePct() {
      var self = this;
      return this._memo("savingsRatePct", function () {
        var rows = self.$store.budget.reportIncomeVsExpense(null, 3) || [];
        if (!rows.length) return null;
        var sumI = 0, sumE = 0;
        rows.forEach(function (r) { sumI += r.income; sumE += r.expense; });
        if (sumI <= 0) return null;
        return ((sumI - sumE) / sumI) * 100;
      });
    },
    savingsRateLabel() {
      var p = this.savingsRatePct();
      if (p === null) return "—";
      return p.toFixed(0) + "%";
    },
    savingsBandClass() {
      var p = this.savingsRatePct();
      if (p === null) return "rec-summary__tile--accent";
      if (p < 0)      return "rec-summary__tile--outflow";
      if (p >= 20)    return "rec-summary__tile--net";
      return "rec-summary__tile--accent";
    },

    /* ---- Upcoming bills (delegated to store) — memoized ---- */
    upcoming7()  {
      var self = this;
      return this._memo("upcoming7",  function () { return self.$store.budget.upcomingBills(7); });
    },
    upcoming14() {
      var self = this;
      return this._memo("upcoming14", function () { return self.$store.budget.upcomingBills(14); });
    },

    /* ---- Overspent count ---- */
    overspent() {
      var self = this;
      return this._memo("overspent", function () { return self.$store.budget.overspentCount(); });
    },

    /* ---- Top spending categories this month — memoized ---- */
    topCategoriesRows() {
      var self = this;
      return this._memo("topCategoriesRows", function () {
        var m = self.$store.budget.currentMonth;
        var data = self.$store.budget.reportSpending(m, m) || [];
        if (!data.length) return [];
        var max = data[0].value || 1;
        return data.slice(0, 5).map(function (r) {
          return {
            categoryId: r.categoryId,
            category: r.category,
            value: r.value,
            pct: max > 0 ? Math.round((r.value / max) * 100) : 0,
          };
        });
      });
    },

    /* ---- Goals needing attention — memoized ---- */
    goalsAttention() {
      var self = this;
      return this._memo("goalsAttention", function () { return self.$store.budget.goalsNeedingAttention(3); });
    },

    /* ---- Recent transactions (last 10, newest first) — memoized ---- */
    recentTransactions() {
      var self = this;
      return this._memo("recentTransactions", function () {
        if (!self.$store.budget.profile) return [];
        var arr = self.$store.budget.profile.transactions.slice();
        arr.sort(function (a, b) { return b.date.localeCompare(a.date); });
        return arr.slice(0, 10);
      });
    },

    /* ---- Alerts (delegated to store) — memoized ---- */
    alerts() {
      var self = this;
      return this._memo("alerts", function () { return self.$store.budget.dashboardAlerts(); });
    },
  };
}
</script>

<script type="module">
  /* Sparkline-shaped variants of the income-expense + projection
     renderers used by the report pages. Compact: hide the legend
     + axis ticks so the chart reads as a sparkline, not a full
     report visual. */
  import { mountChart } from "/assets/js/charts/bootstrap.js";
  import { upsert, fmtCents } from "/assets/js/charts/chartjs.js";
  import { colors } from "/assets/js/charts/theme-colors.js";

  function renderIE(el, data) {
    if (!el || !window.Chart) return;
    if (!data || !data.length) {
      el.innerHTML = "<p style=\"padding: var(--space-sm); color: var(--fg-muted); font-size: var(--fs-sm);\">No data yet.</p>";
      return;
    }
    var c = colors();
    upsert(el, {
      type: "bar",
      pbSubType: "dash-bar",
      data: {
        labels: data.map(function (d) { return d.month.slice(5); }),
        datasets: [
          { label: "Income",  data: data.map(function (d) { return d.income; }),  backgroundColor: c["chart-1"], borderRadius: 0 },
          { label: "Expense", data: data.map(function (d) { return d.expense; }), backgroundColor: c["chart-5"], borderRadius: 0 },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: true, position: "bottom", labels: { boxWidth: 10 } } },
        scales: {
          x: { grid: { display: false } },
          y: {
            beginAtZero: true,
            grid: { color: c["border"] },
            ticks: { callback: function (v) { return fmtCents(v); } },
          },
        },
      },
    });
  }

  function renderProj(el, data) {
    if (!el || !window.Chart) return;
    if (!data || !data.length) {
      el.innerHTML = "<p style=\"padding: var(--space-sm); color: var(--fg-muted); font-size: var(--fs-sm);\">Not enough history to project yet.</p>";
      return;
    }
    /* Trim to the next 30 days (~1 month) so this sparkline doesn't
       redraw the same 12-month canvas as the full report. */
    var trimmed = data.slice(0, 2);
    var c = colors();
    upsert(el, {
      type: "line",
      pbSubType: "dash-line",
      data: {
        labels: trimmed.map(function (d) { return d.month; }),
        datasets: [
          { label: "Low",      data: trimmed.map(function (d) { return d.low; }),      borderColor: "transparent", pointRadius: 0, fill: false, tension: 0.25 },
          { label: "High",     data: trimmed.map(function (d) { return d.high; }),     borderColor: "transparent", backgroundColor: "rgba(192, 57, 43, 0.15)", fill: "-1", pointRadius: 0, tension: 0.25 },
          { label: "Expected", data: trimmed.map(function (d) { return d.expected; }), borderColor: c["chart-1"], backgroundColor: c["chart-1"], fill: false, tension: 0.25, pointRadius: 3, pointHoverRadius: 6, borderWidth: 2 },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { labels: { filter: function (item) { return item.text === "Expected"; }, boxWidth: 10 } },
        },
        scales: {
          x: { grid: { display: false } },
          y: { grid: { color: c["border"] }, ticks: { callback: function (v) { return fmtCents(v); } } },
        },
      },
    });
  }

  window.pbMountChart = mountChart;
  window.pbDashRenderIE   = renderIE;
  window.pbDashRenderProj = renderProj;
</script>
