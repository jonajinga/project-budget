---
layout: layouts/app.njk
title: "Dashboard"
description: "Your active budget at a glance -- ready to work, net worth, this month's flow, upcoming bills, goal progress, and alerts."
permalink: /app/
eleventyExcludeFromCollections: true
---
{% from "partials/overflow-menu.njk" import overflow %}
{% from "partials/app-toolbar.njk" import appToolbar %}
{% import "partials/dashboard-widgets.njk" as W %}
{% import "partials/dashboard-views.njk" as V2 %}
{% import "partials/dashboard-body.njk" as B %}
<div class="app-page app-page--dense" x-data="dashboardView()" x-init="init()">
  {# The dashboard picker, the widget count and the edit controls were
     their own row under the masthead. They are this page's controls, so
     they are the strip. The old lead was the profile name, which the app
     header already carries at the top left. #}
  {% call appToolbar("Dashboard") %}
    <div class="app-toolbar__group" x-show="$store.budget.profile" x-cloak>
        {# A tab strip, not a <select>. Dashboards are places you switch
           between, and a strip shows how many there are and which one you are
           on without opening anything. It scrolls horizontally rather than
           wrapping, so a long list never pushes the actions off the row.

           `id="dash-picker"` is kept on the strip because it is the labelled
           control for this group. #}
        <div id="dash-picker" class="dash-tabs" role="tablist" aria-label="Dashboard">
          <template x-for="d in ($store.budget._listVersion, $store.budget.dashboardList())" :key="d.id">
            <button type="button"
                    class="dash-tabs__tab"
                    role="tab"
                    :class="d.id === activeId() ? 'is-active' : ''"
                    :aria-selected="(d.id === activeId()).toString()"
                    @click="$store.budget.setActiveDashboard(d.id)"
                    x-text="d.name"></button>
          </template>
        </div>
        <span class="dash-toolbar__count"
              x-text="widgets().length + (widgets().length === 1 ? ' widget' : ' widgets')"></span>
    </div>
    <div class="app-toolbar__actions" x-show="$store.budget.profile" x-cloak>
        {# Edit mode is an explicit toggle rather than always-on drag handles.
           A dashboard is read far more often than it is rearranged, and grips
           on every card turn a calm screen into a construction site -- worse,
           they make an accidental drag a normal outcome of trying to scroll
           on a touch screen. #}
        <button type="button" class="btn"
                :class="editing ? 'btn--primary' : ''"
                @click="toggleEdit()"
                :aria-pressed="editing.toString()"
                :data-tip="editing ? 'Finish editing this dashboard.' : 'Rearrange, resize, add or remove widgets.'">
          <span x-text="editing ? 'Done' : 'Edit'"></span>
        </button>

        <button type="button" class="btn" x-show="editing" x-cloak
                @click="openBuilder()"
                data-tip="Add a widget to this dashboard.">Add widget</button>

        {% call overflow(label="Dashboard actions") %}
          <li role="none">
            <button type="button" role="menuitem" class="overflow-menu__item"
                    @click="open = false; newDashboard()">New dashboard...</button>
          </li>
          <li role="none">
            <button type="button" role="menuitem" class="overflow-menu__item"
                    @click="open = false; renameDashboard()">Rename...</button>
          </li>
          <li role="none">
            <button type="button" role="menuitem" class="overflow-menu__item"
                    @click="open = false; $store.budget.duplicateDashboard(activeId())">Duplicate</button>
          </li>
          <li role="none" class="overflow-menu__sep" aria-hidden="true"></li>
          <li role="none">
            <button type="button" role="menuitem" class="overflow-menu__item"
                    @click="open = false; exportPdf()">Export as PDF...</button>
          </li>
          <li role="none">
            <button type="button" role="menuitem" class="overflow-menu__item"
                    @click="open = false; exportLayout()"
                    data-tip="Saves the layout only -- no amounts leave your device.">Export layout...</button>
          </li>
          <li role="none">
            <button type="button" role="menuitem" class="overflow-menu__item"
                    @click="open = false; $refs.importFile.click()">Import layout...</button>
          </li>
          <li role="none" class="overflow-menu__sep" aria-hidden="true"></li>
          <li role="none">
            <button type="button" role="menuitem" class="overflow-menu__item"
                    @click="open = false; resetLayout()">Reset to default layout</button>
          </li>
          <li role="none">
            <button type="button" role="menuitem" class="overflow-menu__item overflow-menu__item--danger"
                    @click="open = false; deleteDashboard()">Delete dashboard</button>
          </li>
        {% endcall %}
        {# `hidden`, not .visually-hidden. This input is a mechanism, not a
           control: it is never focused, tabbed to or clicked by a person --
           the menu item calls .click() on it, which works fine on a
           display:none file input in every current browser. .visually-hidden
           clips to 1x1 instead of removing it, so it rendered as a real 1x1
           target and showed up in the touch census as a control nobody can
           hit. #}
        <input type="file" accept="application/json,.json" x-ref="importFile" hidden
               @change="importLayout($event)">
    </div>
  {% endcall %}

  {# ---- Empty state ---- #}
  <div class="empty-state" x-show="!$store.budget.profile" x-cloak>
    <h2 class="empty-state__title">Create your first profile</h2>
    <p class="empty-state__body">
      A profile is a complete budget -- its own accounts, categories, transactions, and goals. Create as many as you need and switch between them whenever you like. Profiles are stored only in this browser.
    </p>
    <div class="empty-state__actions">
      <a class="btn btn--primary" href="/app/profiles/">Create a profile</a>
      <a class="btn btn--secondary" href="/app/import/">Import a JSON export</a>
    </div>
  </div>

  <div x-show="$store.budget.profile" x-cloak>

    {# Inline quick-add removed -- the persistent FAB
       (src/_includes/partials/fab-quick-add.njk, mounted in
       src/_includes/layouts/app.njk) is the canonical add path
       on every app page including the dashboard. #}


    {# ---- The grid ----
       Widgets come from the active dashboard's ordered list. The :key is the
       widget id so Alpine MOVES existing nodes on reorder instead of
       recreating them -- which is what keeps the Chart.js canvases alive
       through a rearrange. Rebuilding them would leak a chart per move. #}
    <div class="dash-grid"
         :class="editing ? 'is-editing' : ''"
         x-ref="grid"
         x-show="$store.budget.profile" x-cloak>
      <template x-for="(widget, i) in widgets()" :key="widget.id">
        <section class="dash-widget"
                 :class="{ 'is-collapsed': isCollapsed(widget, i), 'has-toggle': phone }"
                 :data-widget-id="widget.id"
                 :data-widget-kind="$store.budget.widgetKind(widget)"
                 :style="widgetStyle(widget)"
                 :aria-label="titleOf(widget)">

          {# Editing chrome. Present only in edit mode, so a widget in read
             mode is exactly the card it always was. #}
          <div class="dash-widget__chrome" x-show="editing" x-cloak>
            <button type="button"
                    class="dash-widget__grip"
                    data-widget-grip
                    :aria-label="'Move ' + titleOf(widget) + '. Press space to pick up, then arrow keys to move, shift and arrows to resize.'"
                    data-tip="Drag to move -- or press space and use the arrow keys.">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <circle cx="9" cy="6" r="1.6"/><circle cx="15" cy="6" r="1.6"/>
                <circle cx="9" cy="12" r="1.6"/><circle cx="15" cy="12" r="1.6"/>
                <circle cx="9" cy="18" r="1.6"/><circle cx="15" cy="18" r="1.6"/>
              </svg>
            </button>
            <span class="dash-widget__name" x-text="titleOf(widget)"></span>
            <span class="dash-widget__size" x-text="widget.w + '\u00d7' + widget.h"></span>
            <button type="button" class="dash-widget__config"
                    @click="configureWidget(widget)"
                    :aria-label="'Configure ' + titleOf(widget)"
                    data-tip="Change what this widget shows.">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9v.09a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
            </button>
            {% call overflow(label="Widget actions", triggerClass="dash-widget__more") %}
              <li role="none">
                <button type="button" role="menuitem" class="overflow-menu__item"
                        @click="open = false; configureWidget(widget)">Configure...</button>
              </li>
              <li role="none">
                <button type="button" role="menuitem" class="overflow-menu__item"
                        @click="open = false; $store.budget.duplicateWidget(activeId(), widget.id)">Duplicate</button>
              </li>
              <li role="none" class="overflow-menu__sep" aria-hidden="true"></li>
              <li role="none">
                <button type="button" role="menuitem" class="overflow-menu__item"
                        @click="open = false; $store.budget.moveWidget(activeId(), widget.id, 0)">Move to top</button>
              </li>
              <li role="none">
                <button type="button" role="menuitem" class="overflow-menu__item"
                        @click="open = false; $store.budget.moveWidget(activeId(), widget.id, widgets().length - 1)">Move to bottom</button>
              </li>
            {% endcall %}
            <button type="button" class="dash-widget__remove"
                    @click="$store.budget.removeWidget(activeId(), widget.id)"
                    :aria-label="'Remove ' + titleOf(widget)"
                    data-tip="Remove this widget. Undo brings it back.">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </button>
          </div>

          {# Phone only: the card's own header, turned into the control that
             folds it away. Rendered only when `phone` is true rather than
             hidden by a media query, so a screen reader on a desktop is
             never told a card is collapsed when it is fully visible.

             The widget's own <h2> is hidden underneath it (see .has-toggle
             in dashboard.css) so the title is not printed twice. #}
          <button type="button" class="dash-widget__toggle"
                  x-show="phone" x-cloak
                  :aria-expanded="(!isCollapsed(widget, i)).toString()"
                  @click="toggleCollapse(widget, i)">
            <span class="dash-widget__toggle-title" x-text="titleOf(widget)"></span>
            <svg class="dash-widget__toggle-mark" width="14" height="14" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"
                 stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </button>

          {{ B.widgetBody() }}

          {# Resize handle. Pointer only -- the keyboard equivalent is
             shift+arrows on the grip, which is discoverable from the grip's
             own label rather than needing a second focusable control. #}
          <button type="button" class="dash-widget__resize" data-widget-resize
                  x-show="editing" x-cloak tabindex="-1" aria-hidden="true"></button>
        </section>
      </template>
    </div>

    {# A brand-new dashboard is deliberately empty. Without this it renders as
       a blank page with a toolbar, which is indistinguishable from breakage --
       it was reported as "entirely broken", and reasonably so. #}
    <div class="dash-empty" x-show="$store.budget.profile && !widgets().length" x-cloak>
      <h2 class="dash-empty__title">This dashboard is empty</h2>
      <p class="dash-empty__body">
        Add the widgets you want, or start from the standard layout and change it.
      </p>
      <div class="dash-empty__actions">
        <button type="button" class="btn btn--primary"
                @click="editing = true; openBuilder()">Add a widget</button>
        <button type="button" class="btn"
                @click="$store.budget.resetDashboard(activeId())">Use the default layout</button>
      </div>
    </div>

    {# ---- Ask / confirm ----
       The two dialogs that replaced window.prompt and window.confirm. Both
       use x-if so their controls stay out of the axe sweep and the touch
       census while closed, and both restate the app's modal contract:
       role=dialog, aria-modal, Escape closes, click outside closes. #}
    <template x-if="ask.open">
      <div class="modal-backdrop" @click.self="ask.open = false"
           @keydown.escape.window="ask.open = false">
        <div class="modal modal--sm" role="dialog" aria-modal="true" aria-labelledby="dash-ask-title">
          <button type="button" class="modal__close" @click="ask.open = false" aria-label="Close">&times;</button>
          <h2 id="dash-ask-title" class="modal__title" x-text="ask.title"></h2>
          <form class="modal__body" @submit.prevent="submitAsk()">
            <div class="field">
              <label class="field__label" for="dash-ask-input" x-text="ask.label"></label>
              <input id="dash-ask-input" class="input" type="text" x-model="ask.value" maxlength="60">
            </div>
            <div class="form-actions">
              <button type="button" class="btn" @click="ask.open = false">Cancel</button>
              <button type="submit" class="btn btn--primary" x-text="ask.confirm"></button>
            </div>
          </form>
        </div>
      </div>
    </template>

    <template x-if="confirmer.open">
      <div class="modal-backdrop" @click.self="confirmer.open = false"
           @keydown.escape.window="confirmer.open = false">
        <div class="modal modal--sm" role="dialog" aria-modal="true" aria-labelledby="dash-confirm-title">
          <button type="button" class="modal__close" @click="confirmer.open = false" aria-label="Close">&times;</button>
          <h2 id="dash-confirm-title" class="modal__title" x-text="confirmer.title"></h2>
          <div class="modal__body">
            <p x-text="confirmer.body"></p>
            <div class="form-actions">
              <button type="button" class="btn" @click="confirmer.open = false">Cancel</button>
              <button type="button" class="btn"
                      :class="confirmer.danger ? 'btn--danger' : 'btn--primary'"
                      @click="submitConfirm()" x-text="confirmer.confirm"></button>
            </div>
          </div>
        </div>
      </div>
    </template>

    {# ---- Widget builder ----

       Rendered with x-if, NOT x-show, and that is an accessibility-budget
       decision rather than a stylistic one. An x-show dialog leaves its dozen
       form controls in the DOM on every axe run of /app/ and in every
       touch-target census pass, where they count against caps that are
       already at their limit. x-if keeps them out until the dialog opens.

       Add and Configure are the same dialog. Configuring is just the same
       form opened over an existing widget, which is why there is one set of
       markup and one commit path rather than two that drift. #}
    <template x-if="builderOpen">
      <div class="modal-backdrop"
           @click.self="closeBuilder()"
           @keydown.escape.window="closeBuilder()">
        <div class="modal modal--wide builder" role="dialog" aria-modal="true"
             aria-labelledby="dash-builder-title">
          <button type="button" class="modal__close" @click="closeBuilder()" aria-label="Close">&times;</button>
          <h2 id="dash-builder-title" class="modal__title"
                x-text="builderMode === 'edit' ? 'Configure widget' : 'Add a widget'"></h2>

          <div class="modal__body builder__body">
            <div class="builder__config">
              {# 1. Source #}
              <div class="field">
                <label class="field__label" for="bld-search">What do you want to see?</label>
                <input id="bld-search" class="input" type="search" x-model="builderSearch"
                       placeholder="Search sources" autocomplete="off">
              </div>
              {# A plain list of buttons, deliberately NOT role="listbox".
                 The sources are grouped, so the options end up nested inside
                 per-group sub-lists rather than as direct children of the
                 listbox - which axe flags as aria-required-children,
                 aria-required-parent and listitem, three NEW rule ids, and
                 the ratchet fails on a new rule id outright rather than
                 budgeting it. Buttons in a list are already operable and
                 announced; aria-pressed carries the selected state. #}
              <ul class="builder__sources" aria-label="Data source">
                <template x-for="grp in builderGroups()" :key="grp.family">
                  <li class="builder__group">
                    <p class="builder__group-title" x-text="grp.label"></p>
                    <ul class="builder__group-list">
                      <template x-for="src in grp.items" :key="src.id">
                        <li>
                          <button type="button" class="builder__source"
                                  :aria-pressed="(draft.source === src.id).toString()"
                                  :class="draft.source === src.id ? 'is-selected' : ''"
                                  :disabled="src.disabled"
                                  @click="chooseSource(src.id)">
                            <span class="builder__source-title" x-text="src.title"></span>
                            <span class="builder__source-desc" x-text="src.description"></span>
                            <span class="builder__source-on" x-show="src.disabled" x-cloak>Already on this dashboard</span>
                          </button>
                        </li>
                      </template>
                    </ul>
                  </li>
                </template>
              </ul>

              {# 2. Shape #}
              <div class="field" x-show="draft.source && builderViews().length > 1" x-cloak>
                <span class="field__label" id="bld-shape-label">Show it as</span>
                <div class="builder__segmented" role="group" aria-labelledby="bld-shape-label">
                  <template x-for="v in builderViews()" :key="v.id">
                    <button type="button"
                            class="builder__seg"
                            :class="draft.view === v.id ? 'is-on' : ''"
                            :aria-pressed="(draft.view === v.id).toString()"
                            @click="chooseView(v.id)"
                            x-text="v.title"></button>
                  </template>
                </div>
              </div>

              {# 3. Options, generated from the source's declared params #}
              <template x-for="prm in builderParams()" :key="prm.key">
                <div class="field">
                  <label class="field__label" :for="'bld-p-' + prm.key" x-text="prm.label"></label>
                  <input class="input"
                         :id="'bld-p-' + prm.key"
                         :type="prm.type === 'int' ? 'number' : (prm.type === 'month' ? 'month' : 'text')"
                         :min="prm.min" :max="prm.max"
                         :value="draft.params[prm.key] == null ? '' : draft.params[prm.key]"
                         @input="setParam(prm, $event.target.value)">
                  <p class="field__hint" x-show="prm.hint" x-cloak x-text="prm.hint"></p>
                </div>
              </template>

              {# 4. Title #}
              <div class="field" x-show="draft.source" x-cloak>
                <label class="field__label" for="bld-title">Name it (optional)</label>
                <input id="bld-title" class="input" type="text" x-model="draft.title"
                       :placeholder="draftSourceTitle()" maxlength="60">
                <p class="field__hint">Two widgets from the same data are told apart by their names.</p>
              </div>
            </div>

            {# Live preview, rendered through the SAME macro the board uses. #}
            <div class="builder__preview" aria-live="off">
              <p class="builder__preview-label">Preview</p>
              <div class="dash-grid builder__preview-grid" x-ref="previewGrid">
                <template x-for="widget in previewList()" :key="widget.id">
                  <section class="dash-widget"
                           :data-widget-id="widget.id"
                           :data-widget-kind="$store.budget.widgetKind(widget)"
                           :style="widgetStyle(widget)"
                           :aria-label="titleOf(widget)">
                    {{ B.widgetBody() }}
                  </section>
                </template>
              </div>
              <p class="builder__preview-empty" x-show="!draft.source" x-cloak>
                Pick a source and it will draw here with your own numbers.
              </p>
            </div>
          </div>

          <div class="modal__foot builder__foot">
            <button type="button" class="btn" @click="closeBuilder()">Cancel</button>
            <button type="button" class="btn btn--primary"
                    :disabled="!draft.source"
                    @click="commitBuilder()"
                    x-text="builderMode === 'edit' ? 'Save changes' : 'Add to dashboard'"></button>
          </div>
        </div>
      </div>
    </template>

  </div>
</div>

<script>
/* activeId() is a method on the component; builderGroups runs before `this`
   is convenient in the closure above, so this keeps the call explicit. */
function activeIdSafe(vm) { return vm.activeId(); }

function dashboardView() {
  return {
    /* ---- Dashboard editing ----
       `editing` is deliberately NOT persisted. Edit mode is a thing you are
       doing right now, not a property of the dashboard; coming back to the
       app a day later and finding every card wearing drag handles reads as
       breakage. */
    editing: false,

    /* ---- Phone: collapsible widget cards (Jon, 2026-09-04) ----
       Thirteen widgets, all open, made the phone dashboard about 7,800
       pixels tall -- roughly twenty screens of scrolling to reach the last
       card. The top four stay open, the rest start collapsed, and whatever
       you open or close afterwards is remembered.

       Remembered in localStorage rather than in the profile, because which
       cards you want folded away is a property of THIS SCREEN, not of the
       budget: the same profile opened on a desktop should not inherit a
       phone's folds. It is also why nothing is ever collapsed above the
       phone breakpoint -- `phone` is a real matchMedia result, not a CSS
       class, so aria-expanded on the toggle always describes what is
       actually on screen instead of what a stylesheet happens to be
       hiding at this width. */
    COLLAPSE_KEY: "projectbudget:dash-collapsed",
    OPEN_BY_DEFAULT: 4,
    phone: false,
    /* { dashboardId: { widgetId: true|false } }. Keyed by dashboard inside
       one entry so switching dashboards needs no reload of this state. */
    collapsed: {},

    _loadCollapsed() {
      try {
        var raw = localStorage.getItem(this.COLLAPSE_KEY);
        var v = raw ? JSON.parse(raw) : null;
        this.collapsed = v && typeof v === "object" && !Array.isArray(v) ? v : {};
      } catch (_e) {
        this.collapsed = {};
      }
    },
    _collapsedFor() {
      return this.collapsed[this.activeId() || "default"] || {};
    },
    /* `i` is the widget's position in the list, which is what "the top four"
       means. An explicit true/false from the person always wins over it. */
    isCollapsed(widget, i) {
      if (!this.phone || !widget) return false;
      var v = this._collapsedFor()[widget.id];
      if (typeof v === "boolean") return v;
      return i >= this.OPEN_BY_DEFAULT;
    },
    toggleCollapse(widget, i) {
      if (!widget) return;
      var dash = this.activeId() || "default";
      var next = Object.assign({}, this.collapsed);
      next[dash] = Object.assign({}, next[dash] || {});
      next[dash][widget.id] = !this.isCollapsed(widget, i);
      this.collapsed = next;
      try {
        localStorage.setItem(this.COLLAPSE_KEY, JSON.stringify(this.collapsed));
      } catch (_e) {}
    },

    /* ---- The builder ----
       One dialog for both "add" and "configure". The draft is a full widget
       descriptor rather than a pile of separate fields, so the live preview
       can render it through the very same macro the board uses and the commit
       is a single call with no assembly step in between. */
    builderOpen: false,
    builderMode: "add",
    builderSearch: "",
    builderEditId: null,
    draft: { source: "", view: "", params: {}, settings: {}, title: "", w: 6, h: 4 },

    openBuilder() {
      this.builderMode = "add";
      this.builderEditId = null;
      this.builderSearch = "";
      this.draft = { source: "", view: "", params: {}, settings: {}, title: "", w: 6, h: 4 };
      this.builderOpen = true;
    },

    /* Configure opens the same form over an existing widget. */
    configureWidget(widget) {
      this.builderMode = "edit";
      this.builderEditId = widget.id;
      this.builderSearch = "";
      this.draft = {
        source: widget.source,
        view: widget.view,
        params: Object.assign({}, widget.params),
        settings: Object.assign({}, widget.settings),
        title: widget.title || "",
        w: widget.w,
        h: widget.h,
      };
      this.builderOpen = true;
    },

    closeBuilder() {
      this.builderOpen = false;
