{# A prose page on the public site -- about, privacy, docs index, blog index.

   Replaces layouts/doc-page.njk, which wrapped the same content in the app
   shell so the Balances sidebar appeared on the privacy policy. The inner
   markup below is carried over unchanged from that file, so these pages
   render exactly as they did; only the shell around them is gone. #}

{% extends "layouts/marketing.njk" %}

{% block content %}
<div class="container container--wide app-doc">
  {% if breadcrumbs %}
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Home</a>
    {% for crumb in breadcrumbs %}
      <span class="breadcrumbs__sep" aria-hidden="true">/</span>
      {% if crumb.url %}<a href="{{ crumb.url }}">{{ crumb.label }}</a>{% else %}<span aria-current="page">{{ crumb.label }}</span>{% endif %}
    {% endfor %}
  </nav>
  {% endif %}

  <header class="app-doc__header">
    <h1 class="app-doc__title">{{ title }}</h1>
    {% if subtitle %}<p class="app-doc__subtitle">{{ subtitle }}</p>{% endif %}
  </header>

  <div class="app-doc__prose prose">
    {{ content | safe }}
  </div>
</div>
{% endblock %}
