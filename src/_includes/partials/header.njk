{% set isApp = page.url and page.url.startsWith("/app/") %}

<header class="site-header {{ 'site-header--app' if isApp else 'site-header--marketing' }}" role="banner">

  {% if isApp %}
    {# ---- App-mode header: hamburger | profile | theme toggle ---- #}
    <div class="container site-header__inner site-header__inner--app">
      {# In app mode the hamburger TOGGLES the app sidebar (Budget /
         Register / Calendar / Balances / Profile switcher). The
         button keeps its own `open` flag in sync with the layout's
         sidebarOpen by listening to the same window events the
         layout listens to. Clicking the button dispatches
         toggle-sidebar (the layout flips its state); the button
         mirrors that on the matching event for aria-expanded +
         label, so the same button opens AND closes the drawer. #}
      <button type="button"
              class="site-header__hamburger"
              aria-controls="app-sidebar"
              x-data="{ open: false }"
              @open-sidebar.window="open = true"
              @close-sidebar.window="open = false"
              @toggle-sidebar.window="open = !open"
              :aria-expanded="open.toString()"
              :aria-label="open ? 'Close app navigation' : 'Open app navigation'"
              :data-tip="open ? 'Close the app sidebar.' : 'Open the app sidebar — Budget, Register, Calendar, Balances, and profile switcher.'"
              @click="$dispatch('toggle-sidebar')">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6"  x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>

      <a class="site-header__profile" href="/app/"
         x-data
         data-tip="Open the dashboard for this profile.">
        <span class="site-header__profile-name"
              x-text="$store.budget && $store.budget.profile ? $store.budget.profile.name : 'No profile yet'"></span>
      </a>

      <div class="site-header__actions" x-data>
        {# ---- History cluster: back / forward | undo / redo ----

           All four are ALWAYS rendered and disabled when they would do
           nothing, rather than appearing and vanishing. A control that
           disappears moves everything beside it, so the button under the
           pointer changes between one glance and the next; a dimmed one
           stays put and also answers "can I undo right now?" without the
           user having to try it.

           Back/forward mirror the browser's own buttons, which the
           in-app router makes ambiguous -- the address bar changes, so
           people reach for them, and the router owns that history.
           canGoBack/canGoForward come from the router, which tracks its
           position by stamping an index into each history state; the
           browser will not tell a page whether back leads anywhere. #}
        <div class="history-nav"
             x-data="{ canBack: false, canForward: false }"
             @pb:history.window="canBack = $event.detail.canBack; canForward = $event.detail.canForward">
          <button type="button"
                  class="site-header__iconbtn"
                  :disabled="!canBack"
                  @click="window.pbRouter && window.pbRouter.goBack()"
                  data-tip="Back to the previous screen."
                  aria-label="Back">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <button type="button"
                  class="site-header__iconbtn"
                  :disabled="!canForward"
                  @click="window.pbRouter && window.pbRouter.goForward()"
                  data-tip="Forward to the screen you came back from."
                  aria-label="Forward">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>

        <span class="history-nav__sep" aria-hidden="true"></span>

        {# Undo and redo are split controls: the icon does one step, the
           caret opens the list so several can be undone in one go. The
           list is what makes this recoverable rather than a guessing
           game -- six bad edits used to mean six clicks and reading the
           toast each time to check you had not gone too far. #}
        <div class="history-split" x-data="overflowMenu('right')">
          <button type="button"
                  class="site-header__iconbtn history-split__main"
                  :disabled="!($store.budget && $store.budget.canUndo && $store.budget.canUndo())"
                  @click="$store.budget.undo()"
                  :data-tip="($store.budget && $store.budget.canUndo && $store.budget.canUndo()) ? ('Undo: ' + ($store.budget.undoLabel() || 'last action') + ' (Ctrl/⌘+Z)') : 'Nothing to undo yet.'"
                  aria-label="Undo">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5v0a5.5 5.5 0 0 1-5.5 5.5H11"/></svg>
          </button>
          <button type="button"
                  x-ref="trigger"
                  class="history-split__caret"
                  :disabled="!($store.budget && $store.budget.canUndo && $store.budget.canUndo())"
                  :aria-expanded="open.toString()"
                  aria-haspopup="menu"
                  aria-label="Undo history"
                  data-tip="Pick how far back to undo."
                  @click="open = !open">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <ul x-ref="list"
              class="overflow-menu__list overflow-menu__list--right history-menu"
              role="menu" x-show="open" x-cloak
              @keydown.escape.window="open = false"
              @click.outside="open = false"
              x-transition.opacity.duration.120ms>
            <li role="none" class="history-menu__head">Undo back to…</li>
            <template x-for="(item, i) in ($store.budget ? $store.budget.undoHistory() : [])" :key="'u' + i">
              <li role="none">
                <button type="button" role="menuitem" class="overflow-menu__item history-menu__item"
                        @click="open = false; $store.budget.undoMany(item.steps)">
                  <span class="history-menu__label" x-text="item.label"></span>
                  <span class="history-menu__meta"
                        x-text="$store.budget.historyAge(item.at) + (item.steps > 1 ? ' · ' + item.steps + ' steps' : '')"></span>
                </button>
              </li>
            </template>
          </ul>
        </div>

        <div class="history-split" x-data="overflowMenu('right')">
          <button type="button"
                  class="site-header__iconbtn history-split__main"
                  :disabled="!($store.budget && $store.budget.canRedo && $store.budget.canRedo())"
                  @click="$store.budget.redo()"
                  :data-tip="($store.budget && $store.budget.canRedo && $store.budget.canRedo()) ? ('Redo: ' + ($store.budget.redoLabel() || 'last undone action') + ' (Ctrl/⌘+Shift+Z)') : 'Nothing to redo.'"
                  aria-label="Redo">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 14 5-5-5-5"/><path d="M20 9H9.5A5.5 5.5 0 0 0 4 14.5v0A5.5 5.5 0 0 0 9.5 20H13"/></svg>
          </button>
          <button type="button"
                  x-ref="trigger"
                  class="history-split__caret"
                  :disabled="!($store.budget && $store.budget.canRedo && $store.budget.canRedo())"
                  :aria-expanded="open.toString()"
                  aria-haspopup="menu"
                  aria-label="Redo history"
                  data-tip="Pick how far forward to redo."
                  @click="open = !open">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <ul x-ref="list"
              class="overflow-menu__list overflow-menu__list--right history-menu"
              role="menu" x-show="open" x-cloak
              @keydown.escape.window="open = false"
              @click.outside="open = false"
              x-transition.opacity.duration.120ms>
            <li role="none" class="history-menu__head">Redo forward to…</li>
            <template x-for="(item, i) in ($store.budget ? $store.budget.redoHistory() : [])" :key="'r' + i">
              <li role="none">
                <button type="button" role="menuitem" class="overflow-menu__item history-menu__item"
                        @click="open = false; $store.budget.redoMany(item.steps)">
                  <span class="history-menu__label" x-text="item.label"></span>
                  <span class="history-menu__meta"
                        x-text="$store.budget.historyAge(item.at) + (item.steps > 1 ? ' · ' + item.steps + ' steps' : '')"></span>
                </button>
              </li>
            </template>
          </ul>
        </div>

        <button type="button"
                class="site-header__search"
                aria-label="Search the site"
                data-tip="Search docs, blog, glossary (Ctrl+K / Cmd+K)."
                onclick="window.ProjectBudget && window.ProjectBudget.openSearch && window.ProjectBudget.openSearch()">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
        {% include "partials/theme-picker.njk" %}
      </div>
    </div>
  {% else %}
    {# ---- Marketing header: single wordmark + horizontal nav ---- #}
    <div class="container site-header__inner">
      <a href="/" class="site-header__brand" aria-label="{{ site.title }} home">
        <span class="brand__mark">{{ site.title }}</span>
      </a>

      <nav class="site-nav" aria-label="Primary">
        <ul class="site-nav__list">
          {% for item in nav.main %}
            <li>
              <a href="{{ item.url }}"
                 class="site-nav__link{% if item.cta %} site-nav__link--cta{% endif %}"
                 {% if page.url == item.url %}aria-current="page"{% endif %}>
                {{ item.label }}
              </a>
            </li>
          {% endfor %}
        </ul>
      </nav>

      <div class="site-header__actions">
        <button type="button"
                class="site-header__search"
                aria-label="Search the site"
                onclick="window.ProjectBudget && window.ProjectBudget.openSearch && window.ProjectBudget.openSearch()">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
        <button type="button"
                class="site-header__hamburger site-header__hamburger--mobile"
                aria-controls="site-menu"
                aria-expanded="false"
                aria-label="Open menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="3" y1="6"  x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
        {% include "partials/theme-picker.njk" %}
      </div>
    </div>
  {% endif %}

  {# Slide-out site-menu is only rendered on marketing pages now —
     on /app/* the hamburger opens the app-sidebar (which also
     carries a Project Budget section with all the marketing links),
     so this second menu would just duplicate it. #}
  {% if not isApp %}
    <div class="site-menu-backdrop" hidden></div>

    <aside class="site-menu" id="site-menu" aria-label="Site menu">
      <div class="site-menu__head">
        <p class="site-menu__brand">{{ site.title }}</p>
        <button type="button" class="site-menu__close" aria-label="Close menu">&times;</button>
      </div>

      <p class="site-menu__group-label">Project Budget</p>
      <ul class="site-menu__list">
        <li><a href="/" class="site-menu__link">Home</a></li>
        {% for item in nav.main %}
          <li><a href="{{ item.url }}" class="site-menu__link">{{ item.label }}</a></li>
        {% endfor %}
        {% for item in nav.footer %}
          <li><a href="{{ item.url }}" class="site-menu__link">{{ item.label }}</a></li>
        {% endfor %}
        <li><a href="{{ site.repo }}" class="site-menu__link" rel="noopener">GitHub</a></li>
      </ul>
    </aside>
  {% endif %}

  {% include "partials/search-modal.njk" %}
</header>
