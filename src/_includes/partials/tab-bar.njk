{# Bottom tab bar — phones only (below 768px).

   Above that the sidebar is a permanent column and a tab bar would duplicate
   it, so this is display:none there.

   Five slots, taken from nav.js's own "Daily" section, which already declares
   the primary IA. The fourth slot is Add rather than Calendar: creating a
   transaction is the single most common action and the FAB was previously the
   only way to do it on a phone.

   The FAB's MODAL is untouched -- only its trigger moves. The centre button
   dispatches the same `open-quick-add` event the FAB button dispatches, so
   there is one add form, one keyboard shortcut, and nothing duplicated.

   Lives outside #app-view (see layouts/app.njk) so the router swaps views
   underneath it and the bar itself never re-renders. #}

<nav class="tab-bar" aria-label="Main"
     x-data="tabBar()"
     @pb:navigated.window="current = $event.detail.path">
  <a href="/app/" class="tab-bar__item"
     :class="{ 'is-active': isActive('/app/') }"
     :aria-current="isActive('/app/') ? 'page' : null">
    <svg class="tab-bar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 10.4L12 3.5l9 6.9V20a1 1 0 01-1 1h-5v-6H9v6H4a1 1 0 01-1-1v-9.6z"></path>
    </svg>
    <span class="tab-bar__label">Home</span>
  </a>

  <a href="/app/budget/" class="tab-bar__item"
     :class="{ 'is-active': isActive('/app/budget/') }"
     :aria-current="isActive('/app/budget/') ? 'page' : null">
    <svg class="tab-bar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="4.5" width="18" height="15" rx="2.5"></rect>
      <path d="M3 9.5h18M8.5 14.5h3"></path>
    </svg>
    <span class="tab-bar__label">Budget</span>
  </a>

  {# Not a link: it opens the quick-add modal that already exists. #}
  <button type="button" class="tab-bar__add" @click="$dispatch('open-quick-add')">
    <span class="tab-bar__add-disc" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
        <path d="M12 5v14M5 12h14"></path>
      </svg>
    </span>
    <span class="visually-hidden">Add transaction</span>
  </button>

  <a href="/app/register/" class="tab-bar__item"
     :class="{ 'is-active': isActive('/app/register/') }"
     :aria-current="isActive('/app/register/') ? 'page' : null">
    <svg class="tab-bar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 6.5h16M4 12h16M4 17.5h10"></path>
    </svg>
    <span class="tab-bar__label">Register</span>
  </a>

  <a href="/app/calendar/" class="tab-bar__item"
     :class="{ 'is-active': isActive('/app/calendar/') }"
     :aria-current="isActive('/app/calendar/') ? 'page' : null">
    <svg class="tab-bar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3.5" y="5" width="17" height="15" rx="2.5"></rect>
      <path d="M3.5 10h17M8 3.5v3M16 3.5v3"></path>
    </svg>
    <span class="tab-bar__label">Calendar</span>
  </a>
</nav>

<script>
  function tabBar() {
    return {
      /* Seeded from the URL at load, then kept in step by pb:navigated --
         the router swaps views without reloading, so nothing else would
         move the active state. */
      current: window.location.pathname,
      isActive(path) {
        if (path === "/app/") return this.current === "/app/";
        return this.current.indexOf(path) === 0;
      },
    };
  }
</script>
