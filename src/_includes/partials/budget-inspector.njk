{# The budget inspector (revamp phase 3).

   One body, two presentations, never both: >=1024px it docks as a
   persistent right-hand pane (x-if inspectorDocked); below that it
   opens as a bottom sheet on the app's modal chrome when a category is
   selected. x-if keeps the two mutually exclusive, so the ids inside
   the shared macro stay unique (duplicate-id-active is zero-tolerance)
   and a closed sheet's controls stay out of axe and the touch census.

   Shares the budgetView() Alpine scope: sel = { catId, month } | null
   drives everything. #}

{% macro inspectorBody() %}
  <div class="budget-inspector__body">
    {# ---- Month overview (nothing selected): where Ready-to-Assign
       stops being an inert number. The breakdown surfaces the rule
       that previously lived only in a source comment (prior-month
       overspending reduces RTA), and every overspent category gets a
       one-click cover from the deepest-pocketed visible category. #}
    <template x-if="!sel">
      <div class="budget-inspector__overview">
        <p class="eyebrow">Month overview</p>
        <h2 class="budget-inspector__title"
            x-text="effectiveMonthCount() > 1
              ? monthShortLabel(visibleMonths()[0]) + ' - ' + monthShortLabel(visibleMonths()[visibleMonths().length - 1])
              : monthHeaderLabel()"></h2>

        {# Checkbox selection: ticking rows previously changed nothing
           here while the hint below claimed nothing was selected. The
           selection gets its own card - combined totals per visible
           month plus the bulk actions. #}
        <section class="budget-inspector__section" aria-label="Selected categories"
                 x-show="selectedCatIds.length" x-cloak>
          <p class="budget-inspector__mcard-label">
            <span x-text="selectedCatIds.length"></span>
            <span x-text="selectedCatIds.length === 1 ? ' category selected' : ' categories selected'"></span>
          </p>
          <template x-for="vm in visibleMonths()" :key="'selt-' + vm">
            <dl class="budget-inspector__break budget-inspector__selgroup">
              <div x-show="effectiveMonthCount() > 1">
                <dt class="budget-inspector__selmonth" x-text="monthShortLabel(vm)"></dt><dd></dd>
              </div>
              <div><dt>Assigned</dt>
                <dd x-text="formatCents(selectionTotals(vm).assigned)"></dd></div>
              <div><dt>Outflow</dt>
                <dd :class="selectionTotals(vm).activity < 0 ? 'amount--outflow' : ''"
                    x-text="formatCents(selectionTotals(vm).activity)"></dd></div>
              <div class="budget-inspector__break-total"><dt>Available</dt>
                <dd :class="selectionTotals(vm).available < 0 ? 'amount--outflow' : 'amount--inflow'"
                    x-text="formatCents(selectionTotals(vm).available)"></dd></div>
            </dl>
          </template>
          <div class="form-actions form-actions--tight">
            <button type="button" class="btn btn--secondary btn--sm" @click="bulkAutoAssign()">Auto-assign</button>
            <button type="button" class="btn btn--ghost btn--sm" @click="bulkClearAssigned('selection')">Clear assigned</button>
            <button type="button" class="btn btn--ghost btn--sm" @click="clearSelection()">Deselect</button>
          </div>
        </section>

        {# One overview card PER VISIBLE MONTH - with 2-3 columns on
           screen, each column's Ready-to-Assign story and overspending
           fixes live here, month by month. Single-month renders
           exactly one card, as before. #}
        <template x-for="vm in visibleMonths()" :key="'ovm-' + vm">
          <section class="budget-inspector__section budget-inspector__mcard"
                   :aria-label="'Overview for ' + monthShortLabel(vm)">
            <p class="budget-inspector__mcard-label"
               x-show="effectiveMonthCount() > 1" x-cloak
               x-text="monthShortLabel(vm)"></p>
            {# The same four lines as the month card, per month - not the
               since-the-beginning-of-time totals the old breakdown showed,
               which read as nonsense after a few years of history. #}
            <dl class="budget-inspector__break">
              <div><dt data-tip="Ready to Work at the end of the previous month.">Left over from <span x-text="monthCardLabel(prevMonthOf(vm), true)"></span></dt>
                <dd data-rta="carried" x-text="formatCents(monthLines(vm).carried)"></dd></div>
              <div><dt data-tip="Uncategorized income received this month.">Inflow in <span x-text="monthCardLabel(vm, true)"></span></dt>
                <dd data-rta="inflow" x-text="'+' + formatCents(monthLines(vm).inflow)"></dd></div>
              <div><dt data-tip="Overspending in the previous month does not follow the category - it comes out of Ready to Work here.">Overspent in <span x-text="monthCardLabel(prevMonthOf(vm), true)"></span></dt>
                <dd data-rta="lost" :class="monthLines(vm).lost > 0 ? 'amount--outflow' : ''"
                    x-text="'-' + formatCents(monthLines(vm).lost)"></dd></div>
              <div><dt data-tip="Everything assigned to categories this month.">Assigned in <span x-text="monthCardLabel(vm, true)"></span></dt>
                <dd data-rta="assigned" x-text="'-' + formatCents(monthLines(vm).assigned)"></dd></div>
              <div class="budget-inspector__break-total"><dt>Ready to Work</dt>
                <dd data-rta="rta" :class="monthLines(vm).rta < 0 ? 'amount--outflow' : 'amount--inflow'"
                    x-text="formatCents(monthLines(vm).rta)"></dd></div>
              <div x-show="monthLines(vm).ahead > 0" x-cloak>
                <dt data-tip="Already assigned in later months. Ready to Work is per month here, so it is not subtracted above.">Assigned ahead</dt>
                <dd x-text="formatCents(monthLines(vm).ahead)"></dd></div>
            </dl>

            <div x-show="overspentCategories(vm).length" x-cloak>
              <p class="field__label">Overspent</p>
              <ul class="budget-inspector__overspent">
                <template x-for="o in overspentCategories(vm)" :key="'ov-' + vm + '-' + o.id">
                  <li :data-overspent-id="o.id">
                    <span class="budget-inspector__txn-payee" x-text="o.name"></span>
                    <span class="num amount--outflow" x-text="'-' + formatCents(o.deficit)"></span>
                    <button type="button" class="btn btn--secondary btn--sm"
                            :disabled="!coverDonor(o.id, vm)"
                            :data-tip="coverDonor(o.id, vm)
                              ? 'Move ' + formatCents(o.deficit) + ' from ' + coverDonor(o.id, vm).name + ' (the category with the most available).'
                              : 'No visible category has money available.'"
                            @click="coverOverspent(o.id, vm)"
                            x-text="'Cover from ' + (coverDonor(o.id, vm)?.name || '...')"></button>
                  </li>
                </template>
              </ul>
            </div>
          </section>
        </template>

        <section class="budget-inspector__section" aria-label="Planned cuts impact"
                 x-show="$store.budget.listCuts().length" x-cloak>
          <p class="field__label">Planned cuts</p>
          <dl class="budget-inspector__break">
            <div><dt>Planned savings</dt>
              <dd data-cuts="planned" class="amount--inflow"
                  x-text="'+' + formatCents($store.budget.cutsSummaryFor($store.budget.currentMonth).monthlyPlanned) + '/mo'"></dd></div>
            <div><dt>Realized this month</dt>
              <dd data-cuts="realized"
                  x-text="formatCents($store.budget.cutsSummaryFor($store.budget.currentMonth).monthlyRealized)"></dd></div>
            <div><dt>Over a year</dt>
              <dd data-cuts="annual" x-text="formatCents($store.budget.cutsSummaryFor($store.budget.currentMonth).annualPlanned)"></dd></div>
            <div><dt data-tip="Planned monthly savings as a share of your average monthly inflow (last 3 months).">Share of income</dt>
              <dd x-text="$store.budget.cutsSummaryFor($store.budget.currentMonth).pctOfAvgInflow + '%'"></dd></div>
            <div><dt data-tip="Each achieved month leaves this much more in Ready to Work than the baseline trajectory.">Ready to Work</dt>
              <dd x-text="'+' + formatCents($store.budget.cutsSummaryFor($store.budget.currentMonth).projectedRtaDelta) + '/mo'"></dd></div>
            <div x-show="$store.budget.ageOfMoneyStat() != null" x-cloak>
              <dt data-tip="How old the dollars you spend are (YNAB's metric) - and where the cuts would push it.">Age of money</dt>
              <dd data-cuts="aom"
                  x-text="$store.budget.ageOfMoneyStat() + ' days'
                    + ($store.budget.projectedAgeOfMoneyStat($store.budget.currentMonth) > $store.budget.ageOfMoneyStat()
                       ? ' -> ' + $store.budget.projectedAgeOfMoneyStat($store.budget.currentMonth) + ' days'
                       : '')"></dd></div>
          </dl>
          <ul class="budget-inspector__cutlist">
            <template x-for="cut in $store.budget.listCuts()" :key="'cut-' + cut.id">
              <li>
                <span class="budget-inspector__txn-payee"
                      x-text="$store.budget.categoryName(cut.categoryId) + (cut.goalLabel ? ' · ' + cut.goalLabel : '')"></span>
                <span class="num" x-text="($store.budget.cutProgressFor(cut.id, $store.budget.currentMonth)?.pct || 0) + '%'"></span>
              </li>
            </template>
          </ul>
        </section>

        <p class="budget-inspector__hint" x-show="!selectedCatIds.length">
          Click a category name or an Available pill for its breakdown,
          notes, goal and recent activity - or tick checkboxes to see
          the selection totalled here.
        </p>
      </div>
    </template>

    {# ---- Category mode ---- #}
    <template x-if="sel">
      <div class="insp">
        <header class="insp__head">
          <div class="insp__head-row">
            <p class="eyebrow insp__eyebrow">
              <span x-text="selGroupName()"></span>
              <span aria-hidden="true"> · </span>
              <span x-text="monthCardLabel(sel.month)"></span>
            </p>
            <div class="insp__head-tools">
              {# Rename / hide / delete live in one menu so the title line
                 is the title and nothing else. #}
              <div class="overflow-menu" x-data="overflowMenu('right')"
                   @keydown.escape.window="open = false" @click.outside="open = false">
                <button type="button" x-ref="trigger" class="btn btn--icon insp__iconbtn overflow-menu__trigger"
                        :class="open ? 'is-open' : ''" :aria-expanded="open.toString()" aria-haspopup="menu"
                        aria-label="Category actions" data-tip="Rename, hide or delete this category."
                        @click="open = !open">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="6" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="18" r="2"/></svg>
                </button>
                <ul x-ref="list" class="overflow-menu__list overflow-menu__list--right" role="menu" x-show="open" x-cloak>
                  <li role="none"><a role="menuitem" class="overflow-menu__item"
                          :href="'/app/category/?cat=' + encodeURIComponent(selCategory().id)">History and charts</a></li>
                  <li role="none" class="overflow-menu__sep" aria-hidden="true"></li>
                  <li role="none"><button type="button" role="menuitem" class="overflow-menu__item"
                          @click="open = false; startInspectorRename()">Rename...</button></li>
                  <li role="none"><button type="button" role="menuitem" class="overflow-menu__item"
                          @click="open = false; openNotes(selCategory())">Notes...</button></li>
                  <li role="none" class="overflow-menu__sep" aria-hidden="true"></li>
                  <li role="none"><button type="button" role="menuitem" class="overflow-menu__item"
                          @click="open = false; hideSelected()">Hide category</button></li>
                  <li role="none"><button type="button" role="menuitem" class="overflow-menu__item overflow-menu__item--danger"
                          @click="open = false; deleteCategoryRow(selCategory())">Delete category</button></li>
                </ul>
              </div>
              <button type="button" class="btn btn--icon insp__iconbtn" x-show="inspectorDocked"
                      @click="clearSel()" aria-label="Back to month overview" data-tip="Deselect (Escape does this too).">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="6" y1="18" x2="18" y2="6"/></svg>
              </button>
            </div>
          </div>
          <template x-if="!renameEditing">
            <h2 class="insp__title" x-text="selCategory()?.name || ''"></h2>
          </template>
          <template x-if="renameEditing">
            <input class="input insp__rename" id="insp-rename" type="text" x-model="renameDraft"
                   aria-label="Category name"
                   @keydown.enter="commitInspectorRename()"
                   @keydown.escape.stop="renameEditing = false"
                   @blur="commitInspectorRename()">
          </template>
        </header>

        {# Hero: the number, its status, and (with a goal) the goal line
           with a fixed-length bar. Then the three terms behind it. #}
        <section class="insp__hero" aria-label="Available">
          <div class="insp__hero-top">
            <div>
              <span class="insp__avail-label">Available</span>
              <strong class="insp__avail-num num" data-break="available"
                      :class="(selRow()?.available || 0) < 0 ? 'amount--outflow' : ((selRow()?.available || 0) > 0 ? 'amount--inflow' : '')"
                      x-text="formatCents(selRow()?.available || 0)"></strong>
            </div>
            <span class="insp__status" :class="'insp__status--' + selStatus().kind"
                  x-show="selStatus().kind !== 'ok'" x-cloak x-text="selStatus().label"></span>
          </div>
          <div class="insp__goal-line" x-show="$store.budget.findGoal(sel.catId)" x-cloak>
            <div class="goal-bar" :class="goalBarClass(sel.catId)"
                 :style="'--pct:' + goalPercent(sel.catId)"
                 role="progressbar" aria-label="Goal progress"
                 :aria-valuenow="goalPercent(sel.catId)" aria-valuemin="0" aria-valuemax="100">
              <span class="goal-bar__track"><span class="goal-bar__fill"></span></span>
              <span class="goal-bar__cap" x-text="goalPercent(sel.catId) >= 100 ? '✓ 100%' : (goalPercent(sel.catId) + '%')"></span>
            </div>
            <p class="insp__goal-text" x-text="goalLine()"></p>
          </div>
          <dl class="insp__strip">
            <div data-tip="What rolled over from prior months. Negative balances do not roll; they come out of next month's Ready to Work.">
              <dt>Carry-in</dt><dd class="num" data-break="carryIn" x-text="formatCents(selRow()?.carryIn || 0)"></dd></div>
            <div><dt>Assigned</dt><dd class="num" data-break="assigned" x-text="formatCents(selRow()?.assigned || 0)"></dd></div>
            <div><dt>Outflow</dt><dd class="num" data-break="activity" :class="(selRow()?.activity || 0) < 0 ? 'amount--outflow' : ''" x-text="formatCents(selRow()?.activity || 0)"></dd></div>
          </dl>
        </section>

        {# Six months of outflow at a glance, with the average. #}
        <section class="insp__spark" aria-label="Spending, last six months" x-show="selSpark().max > 0" x-cloak>
          <div class="insp__spark-head">
            <span class="insp__spark-title">Last 6 months</span>
            <span class="insp__spark-avg num" x-text="'avg ' + formatCents(selSpark().avg) + '/mo'"></span>
          </div>
          {# Plain HTML bars: they scale with the pane without distorting,
             and each one carries its month's amount as a tooltip. #}
          <div class="insp__bars">
            <template x-for="b in selSpark().bars" :key="'sp-' + b.month">
              <div class="insp__bar-col" :data-tip="monthCardLabel(b.month) + ': ' + formatCents(b.out)">
                <div class="insp__bar-track">
                  <div class="insp__bar" :class="b.current ? 'is-current' : ''" :style="{ height: (b.out > 0 ? Math.max(4, b.pct) : 0) + '%' }"></div>
                </div>
                <span class="insp__bar-label" x-text="b.label"></span>
              </div>
            </template>
          </div>
        </section>

        {# Assign: the amount for this month, then suggestions that
           would actually change something (zero and no-op fills are
           not offered). Payment pools and income categories explain
           themselves instead. #}
        <section class="insp__sec" aria-label="Assign">
          <template x-if="!assignReadOnly(selCategory() || {})">
            <div>
              <form class="insp__assign" @submit.prevent="commitAssignDraft()">
                <label class="insp__assign-label" for="insp-assign">Assigned in <span x-text="monthCardLabel(sel.month, true)"></span></label>
                <div class="insp__assign-row">
                  <span class="insp__assign-cur" aria-hidden="true">$</span>
                  <input class="input num insp__assign-input" id="insp-assign" type="text" inputmode="decimal"
                         x-model="assignDraft" placeholder="0.00"
                         data-tip="Type an amount, or an expression like 100+25."
                         @focus="$event.target.select()">
                  <button class="btn btn--primary btn--sm" type="submit">Assign</button>
                </div>
              </form>
              <div class="insp__chips" role="group" aria-label="Suggestions" x-show="suggestionList().length" x-cloak>
                <template x-for="sug in suggestionList()" :key="'sug-' + sug.kind">
                  <button type="button" class="insp__chip" :data-tip="sug.tip" @click="applyQuickFill(sug.kind, sug.undo)">
                    <span x-text="sug.label"></span>
                    <span class="num" x-text="sug.text"></span>
                  </button>
                </template>
              </div>
            </div>
          </template>
          <template x-if="assignReadOnly(selCategory() || {})">
            <p class="insp__hint"
               x-text="$store.budget.isPaymentCategory(sel.catId)
                 ? 'A payment pool fills itself from spending on the card. To top it up, move money into it below.'
                 : 'Income categories receive money from transactions; assign it from Ready to Work instead.'"></p>
          </template>
        </section>

        {# Collapsible sections: a one-line summary when closed. #}
        <section class="insp__sec insp__sec--disc" aria-label="Goal">
          <button type="button" class="insp__disc" :aria-expanded="secOpen.goal.toString()" @click="secOpen.goal = !secOpen.goal">
            <span class="insp__disc-title">Goal</span>
            <span class="insp__disc-meta" x-text="goalSummary()"></span>
            <svg class="insp__disc-chev" :class="secOpen.goal ? 'is-open' : ''" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="insp__disc-body" x-show="secOpen.goal" x-cloak>
            <div class="goal-bar" x-show="$store.budget.findGoal(sel.catId)" x-cloak
                 :class="goalBarClass(sel.catId)"
                 :style="'--pct:' + goalPercent(sel.catId)"
                 role="progressbar" aria-label="Goal progress"
                 :aria-valuenow="goalPercent(sel.catId)" aria-valuemin="0" aria-valuemax="100">
              <span class="goal-bar__track"><span class="goal-bar__fill"></span></span>
              <span class="goal-bar__cap" x-text="goalPercent(sel.catId) >= 100 ? '✓ 100%' : (goalPercent(sel.catId) + '%')"></span>
            </div>
            <p class="insp__hint" x-show="$store.budget.findGoal(sel.catId)" x-cloak x-text="goalNarrative()"></p>
            <form @submit.prevent="saveGoal()">
              <div class="form-row">
                <div class="field">
                  <label class="field__label" for="insp-goal-type">Type</label>
                  <select class="select" id="insp-goal-type" x-model="goalForm.type">
                    <template x-for="t in $store.budget.GOAL_TYPES" :key="t.value">
                      <option :value="t.value" x-text="t.label"></option>
                    </template>
                  </select>
                </div>
                <div class="field">
                  <label class="field__label" for="insp-goal-target">Target</label>
                  <input class="input" id="insp-goal-target" type="text" x-model="goalForm.target" inputmode="decimal" placeholder="0.00">
                </div>
              </div>
              <p class="field__hint" x-text="goalTypeHint()"></p>
              <div class="field" x-show="goalForm.type === 'targetByDate'" x-cloak>
                <label class="field__label" for="insp-goal-date">By date</label>
                <input class="input" id="insp-goal-date" type="date" x-model="goalForm.byDate">
                <p class="field__hint" x-show="goalForm.byDate" x-cloak x-text="goalDateHint()"></p>
              </div>
              <div class="form-actions form-actions--tight">
                <button class="btn btn--primary btn--sm" type="submit" :disabled="!parseDollars(goalForm.target)">Save goal</button>
                <button class="btn btn--ghost btn--sm" type="button" @click="removeGoal()" x-show="$store.budget.findGoal(sel.catId)">Remove goal</button>
              </div>
            </form>
          </div>
        </section>

        <section class="insp__sec insp__sec--disc" aria-label="Planned cut">
          <button type="button" class="insp__disc" :aria-expanded="secOpen.cut.toString()" @click="secOpen.cut = !secOpen.cut">
            <span class="insp__disc-title">Planned cut</span>
            <span class="insp__disc-meta" x-text="cutSummary()"></span>
            <svg class="insp__disc-chev" :class="secOpen.cut ? 'is-open' : ''" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="insp__disc-body" x-show="secOpen.cut" x-cloak>
            <template x-if="$store.budget.cutForCategory(sel.catId)">
              <div>
                <div class="goal-bar goal-bar--cut" :style="'--pct:' + ($store.budget.cutProgressFor($store.budget.cutForCategory(sel.catId).id, sel.month)?.pct || 0)"
                     :class="($store.budget.cutProgressFor($store.budget.cutForCategory(sel.catId).id, sel.month)?.pct || 0) >= 100 ? 'goal-bar--funded' : ''"
                     role="progressbar" aria-label="Cut progress this month"
                     :aria-valuenow="$store.budget.cutProgressFor($store.budget.cutForCategory(sel.catId).id, sel.month)?.pct || 0"
                     aria-valuemin="0" aria-valuemax="100">
                  <span class="goal-bar__track"><span class="goal-bar__fill"></span></span>
                  <span class="goal-bar__cap" x-text="($store.budget.cutProgressFor($store.budget.cutForCategory(sel.catId).id, sel.month)?.pct || 0) + '%'"></span>
                </div>
                <p class="insp__hint" x-text="cutTooltip(sel.catId)"></p>
              </div>
            </template>
            <form @submit.prevent="saveCut()">
              <div class="form-row">
                <div class="field">
                  <label class="field__label" for="insp-cut-mode">Cut by</label>
                  <select class="select" id="insp-cut-mode" x-model="cutForm.mode">
                    <option value="percent">% of baseline</option>
                    <option value="amount">$ per month</option>
                  </select>
                </div>
                <div class="field">
                  <label class="field__label" for="insp-cut-value" x-text="cutForm.mode === 'percent' ? 'Percent' : 'Amount'"></label>
                  <input class="input" id="insp-cut-value" type="text" inputmode="decimal"
                         x-model="cutForm.value" :placeholder="cutForm.mode === 'percent' ? '25' : '50.00'">
                </div>
              </div>
              <div class="form-row">
                <div class="field">
                  <label class="field__label" for="insp-cut-goal">Toward (optional)</label>
                  <input class="input" id="insp-cut-goal" type="text" x-model="cutForm.goalLabel" placeholder="e.g. Vacation">
                </div>
                <div class="field">
                  <label class="field__label" for="insp-cut-month">By (optional)</label>
                  <input class="input" id="insp-cut-month" type="month" x-model="cutForm.targetMonth">
                </div>
              </div>
              <div class="form-actions form-actions--tight">
                <button class="btn btn--primary btn--sm" type="submit">Save cut</button>
                <button class="btn btn--ghost btn--sm" type="button" x-show="$store.budget.cutForCategory(sel.catId)" x-cloak @click="removeCutSelected()">Remove cut</button>
              </div>
            </form>
          </div>
        </section>

        <section class="insp__sec insp__sec--disc" aria-label="Move money">
          <button type="button" class="insp__disc" :aria-expanded="secOpen.move.toString()" @click="secOpen.move = !secOpen.move">
            <span class="insp__disc-title">Move money</span>
            <span class="insp__disc-meta">Between categories</span>
            <svg class="insp__disc-chev" :class="secOpen.move ? 'is-open' : ''" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="insp__disc-body" x-show="secOpen.move" x-cloak>
            <form @submit.prevent="submitMoveMoney()">
              <div class="field">
                <label class="field__label" for="insp-mv-from">From</label>
                <select class="select" id="insp-mv-from" x-model="moveMoneyForm.fromId"
                        x-init="$nextTick(() => { $el.value = moveMoneyForm.fromId; })">
                  <template x-for="opt in moveMoneyCategoryOptions()" :key="'if-' + opt.id">
                    <option :value="opt.id" x-text="opt.label + ' · ' + formatCents(opt.available)"></option>
                  </template>
                </select>
              </div>
              <div class="field">
                <label class="field__label" for="insp-mv-to">To</label>
                <select class="select" id="insp-mv-to" x-model="moveMoneyForm.toId">
                  <option value="">Select category</option>
                  <template x-for="opt in moveMoneyCategoryOptions()" :key="'it-' + opt.id">
                    <option :value="opt.id" :disabled="opt.id === moveMoneyForm.fromId" x-text="opt.label + ' · ' + formatCents(opt.available)"></option>
                  </template>
                </select>
              </div>
              <div class="insp__assign-row">
                <input class="input num" id="insp-mv-amount" type="text" x-model="moveMoneyForm.amount" inputmode="decimal" placeholder="0.00" aria-label="Amount to move">
                <button class="btn btn--primary btn--sm" type="submit"
                        :disabled="!moveMoneyForm.fromId || !moveMoneyForm.toId || moveMoneyForm.fromId === moveMoneyForm.toId">Move</button>
              </div>
            </form>
          </div>
        </section>

        <section class="insp__sec insp__sec--disc" aria-label="Notes">
          <button type="button" class="insp__disc" :aria-expanded="secOpen.notes.toString()" @click="secOpen.notes = !secOpen.notes">
            <span class="insp__disc-title">Notes</span>
            <span class="insp__disc-meta" x-text="notesSummary()"></span>
            <svg class="insp__disc-chev" :class="secOpen.notes ? 'is-open' : ''" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="insp__disc-body" x-show="secOpen.notes" x-cloak>
            <label class="field__label" for="insp-note">Category note</label>
            <textarea class="input budget-inspector__note" id="insp-note" rows="2" x-model="noteDraft" @blur="commitNote()" placeholder="Applies to every month"></textarea>
            <label class="field__label" for="insp-note-month" x-text="monthCardLabel(sel.month, true) + ' note'"></label>
            <textarea class="input budget-inspector__note" id="insp-note-month" rows="2" x-model="noteMonthDraft" @blur="commitMonthNote()" :placeholder="'Just for ' + monthCardLabel(sel.month, true)"></textarea>
          </div>
        </section>

        <section class="insp__sec insp__sec--disc" aria-label="Recent activity">
          <button type="button" class="insp__disc" :aria-expanded="secOpen.activity.toString()" @click="secOpen.activity = !secOpen.activity">
            <span class="insp__disc-title">Activity</span>
            <span class="insp__disc-meta" x-text="inspectorTxns().length ? (inspectorTxns().length + ' in ' + monthCardLabel(sel.month, true)) : ('None in ' + monthCardLabel(sel.month, true))"></span>
            <svg class="insp__disc-chev" :class="secOpen.activity ? 'is-open' : ''" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="insp__disc-body" x-show="secOpen.activity" x-cloak>
            <ul class="budget-inspector__txns" x-show="inspectorTxns().length" x-cloak>
              <template x-for="t in inspectorTxns()" :key="t.id + '-' + (t.splitKey || '')">
                <li>
                  <span class="budget-inspector__txn-date" x-text="t.date.slice(5)"></span>
                  <span class="budget-inspector__txn-payee" x-text="$store.budget.payeeName(t.payeeId) || '—'"></span>
                  <span class="num" :class="t.amount < 0 ? 'amount--outflow' : 'amount--inflow'" x-text="formatCents(t.amount)"></span>
                </li>
              </template>
            </ul>
            <div class="form-actions form-actions--tight">
              <button class="btn btn--ghost btn--sm" type="button" x-show="inspectorTxns().length" x-cloak
                      @click="openActivity({ kind: 'category', id: sel.catId, name: selCategory()?.name || '', month: sel.month })">See all</button>
              <a class="btn btn--ghost btn--sm" :href="'/app/register/?category=' + sel.catId">Open in register</a>
            </div>
          </div>
        </section>

      </div>
    </template>
  </div>
{% endmacro %}

{# Docked pane (>=1024). x-if, not x-show: the sheet below renders the
   same ids, and only one of the two may exist at a time. #}
<template x-if="inspectorDocked && inspectorOpen">
  <aside class="budget-inspector" aria-label="Budget inspector"
         :style="'--budget-sticky-top:' + stickyTop() + 'px'"
         @keydown.escape.window="!document.querySelector('.modal-backdrop') && sel && clearSel()">
    {{ inspectorBody() }}
  </aside>
</template>

{# Bottom sheet (<1024): the app's modal chrome gives the focus trap
   and restore for free (main.js MutationObserver). #}
<template x-if="!inspectorDocked && (sel || overviewOpen)">
  <div class="modal-backdrop" @click.self="clearSel()"
       @keydown.escape.window="clearSel()">
    <div class="modal modal--sheet" role="dialog" aria-modal="true"
         :aria-label="sel ? ('Inspect ' + (selCategory()?.name || 'category')) : 'Month overview'">
      <button class="modal__close" type="button" @click="clearSel()" aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="6" y1="18" x2="18" y2="6"/></svg>
      </button>
      {{ inspectorBody() }}
    </div>
  </div>
</template>
